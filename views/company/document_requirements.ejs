<%
  const targets = [
    { key: 'driver_profile',  label: 'Şoför',  color: 'blue',    icon: 'driver' },
    { key: 'vehicle_profile', label: 'Araç',   color: 'sky',     icon: 'vehicle' },
    { key: 'hostess_profile', label: 'Hostes', color: 'pink',    icon: 'hostess' },
  ];

  // Aktif sekme — flash veya default driver
  let activeKey = 'driver_profile';
  if (flash && flash.startsWith('saved-')) {
    activeKey = flash.replace('saved-', '');
  }

  const flashMap = {
    'saved-driver_profile':  'Şoför belge gereksinimleri kaydedildi.',
    'saved-vehicle_profile': 'Araç belge gereksinimleri kaydedildi.',
    'saved-hostess_profile': 'Hostes belge gereksinimleri kaydedildi.',
  };
%>

<div class="max-w-4xl mx-auto space-y-6">

  <a href="/dashboard" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
    Dashboard
  </a>

  <!-- Hero -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-5 sm:p-8 shadow-2xl">
    <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl"></div>
    <div class="relative">
      <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-300 mb-2">Kurum Ayarları</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tighter">
        Belge <span class="font-serif italic text-indigo-200">gereksinimleri.</span>
      </h1>
      <p class="text-slate-300/85 text-sm mt-2 max-w-xl">
        Filoya dahil olan şoför, araç ve hostes için hangi belgeleri istediğini işaretle.
        Kaydettiğin liste, kod ile katılan üyelerin karşılaştırma popup'ında ve cron uyarılarında kullanılır.
      </p>
    </div>
  </div>

  <% if (flashMessage = flashMap[flash]) { %>
    <div class="flex items-center gap-3 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 flex-shrink-0"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" /></svg>
      <%= flashMessage %>
    </div>
  <% } %>

  <!-- Tab bar -->
  <div class="flex items-center gap-1 bg-white rounded-2xl ring-1 ring-slate-200 p-1">
    <% targets.forEach(function(t) { %>
      <button type="button"
              data-tab="<%= t.key %>"
              class="tab-btn flex-1 rounded-xl px-4 py-2.5 text-sm font-semibold transition
                     <%= activeKey === t.key
                         ? 'bg-slate-900 text-white shadow-md'
                         : 'text-slate-600 hover:bg-slate-100' %>">
        <%= t.label %>
        <span class="ml-1.5 inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full text-[10px] font-bold
                     <%= activeKey === t.key ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-500' %>">
          <%= requirements[t.key].length %>/<%= catalog[t.key].length %>
        </span>
      </button>
    <% }); %>
  </div>

  <!-- Tab panelleri -->
  <% targets.forEach(function(t) {
    const selectedSet = new Set(requirements[t.key]);
    const items = catalog[t.key];
  %>
    <div class="tab-panel <%= activeKey === t.key ? '' : 'hidden' %>" data-panel="<%= t.key %>">
      <form action="/company/document-requirements" method="POST" class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-5 sm:p-8 space-y-5">
        <input type="hidden" name="target_type" value="<%= t.key %>">

        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <h2 class="text-lg font-bold text-slate-900"><%= t.label %> Belgeleri</h2>
            <p class="text-xs text-slate-500 mt-0.5">
              Aşağıdaki katalogdan, bu kurum için zorunlu olan belgeleri işaretle.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" data-select-all="<%= t.key %>"
                    class="rounded-lg bg-slate-100 text-slate-700 px-3 py-1.5 text-xs font-semibold hover:bg-slate-200 transition">
              Tümünü seç
            </button>
            <button type="button" data-select-none="<%= t.key %>"
                    class="rounded-lg bg-slate-100 text-slate-700 px-3 py-1.5 text-xs font-semibold hover:bg-slate-200 transition">
              Tümünü temizle
            </button>
          </div>
        </div>

        <% if (items.length === 0) { %>
          <p class="text-sm text-slate-500 italic">Bu hedef için sistem-tanımlı belge yok.</p>
        <% } else { %>
          <div class="grid sm:grid-cols-2 gap-2">
            <% items.forEach(function(type) {
              const isChecked = selectedSet.has(type);
            %>
              <label class="flex items-center gap-3 p-3 rounded-xl border transition cursor-pointer
                            <%= isChecked ? 'bg-slate-50 border-slate-300' : 'bg-white border-slate-200 hover:border-slate-300' %>">
                <input type="checkbox" name="document_types[]" value="<%= type %>"
                       <%= isChecked ? 'checked' : '' %>
                       data-target-checkbox="<%= t.key %>"
                       class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900">
                <span class="text-sm font-semibold text-slate-800"><%= labels[type] %></span>
              </label>
            <% }); %>
          </div>
        <% } %>

        <div class="flex justify-end pt-2">
          <button type="submit"
                  class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800 transition shadow-lg shadow-slate-900/25">
            <%= t.label %> Listesini Kaydet
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          </button>
        </div>
      </form>
    </div>
  <% }); %>
</div>

<script>
  (function () {
    // Tab geçişi
    document.querySelectorAll('.tab-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const key = btn.dataset.tab;
        document.querySelectorAll('.tab-btn').forEach(function (b) {
          const active = b.dataset.tab === key;
          b.classList.toggle('bg-slate-900', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('shadow-md', active);
          b.classList.toggle('text-slate-600', !active);
          b.classList.toggle('hover:bg-slate-100', !active);
        });
        document.querySelectorAll('.tab-panel').forEach(function (p) {
          p.classList.toggle('hidden', p.dataset.panel !== key);
        });
      });
    });

    // Tümünü seç / temizle
    document.querySelectorAll('[data-select-all]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const key = btn.dataset.selectAll;
        document.querySelectorAll('[data-target-checkbox="' + key + '"]').forEach(function (cb) {
          cb.checked = true;
          cb.closest('label').classList.add('bg-slate-50', 'border-slate-300');
          cb.closest('label').classList.remove('bg-white', 'border-slate-200');
        });
      });
    });
    document.querySelectorAll('[data-select-none]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const key = btn.dataset.selectNone;
        document.querySelectorAll('[data-target-checkbox="' + key + '"]').forEach(function (cb) {
          cb.checked = false;
          cb.closest('label').classList.remove('bg-slate-50', 'border-slate-300');
          cb.closest('label').classList.add('bg-white', 'border-slate-200');
        });
      });
    });

    // Checkbox tıklandıkça label rengi güncelle
    document.querySelectorAll('[data-target-checkbox]').forEach(function (cb) {
      cb.addEventListener('change', function () {
        const label = cb.closest('label');
        if (cb.checked) {
          label.classList.add('bg-slate-50', 'border-slate-300');
          label.classList.remove('bg-white', 'border-slate-200');
        } else {
          label.classList.remove('bg-slate-50', 'border-slate-300');
          label.classList.add('bg-white', 'border-slate-200');
        }
      });
    });
  })();
</script>
