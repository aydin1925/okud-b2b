<div class="max-w-xl mx-auto space-y-6">

  <div class="text-center">
    <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-600 mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-7 w-7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Kod <span class="font-serif italic text-slate-500">hazır.</span></h2>
    <p class="text-slate-500 mt-2 text-sm">Aşağıdaki kodu ilgili kişiye ilet.</p>
  </div>

  <!-- Kod kutusu -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 sm:p-8 shadow-2xl ring-1 ring-slate-900/10">
    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl"></div>
    <div class="relative text-center">
      <p class="text-[10px] font-bold uppercase tracking-widest text-blue-300 mb-3">Davet Kodu</p>
      <div class="text-3xl sm:text-6xl font-black tracking-[0.2em] sm:tracking-[0.3em] text-white font-mono mb-4 break-all"><%= result.code %></div>
      <button type="button" onclick="copyCode()"
              class="inline-flex items-center gap-2 rounded-xl bg-white/10 backdrop-blur ring-1 ring-white/20 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
        </svg>
        Kopyala
        <span id="copyStatus" class="ml-1 text-emerald-300 font-bold"></span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-3">
    <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-4 text-center">
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Tür</p>
      <p class="text-sm font-bold text-slate-900 mt-1"><%= typeLabels[result.target_type] || result.target_type %></p>
    </div>
    <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-4 text-center">
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Süre</p>
      <p class="text-sm font-bold text-slate-900 mt-1"><%= result.expiry_minutes %> dk</p>
    </div>
    <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-4 text-center">
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Bitiş</p>
      <p class="text-xs font-semibold text-slate-700 mt-1"><%= result.expires_at %></p>
    </div>
  </div>

  <% if (result.label) { %>
    <p class="text-center text-sm text-slate-500"><em>Etiket:</em> <strong class="text-slate-700"><%= result.label %></strong></p>
  <% } %>

  <div class="rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 px-5 py-4 text-sm text-center">
    Kodu <strong>şimdi kopyala</strong> ve ilgili kişiye ilet. Süre dolunca kod geçersiz olur.
  </div>

  <div class="flex items-center justify-center gap-4 text-sm">
    <a href="/company/connections/create" class="inline-flex items-center gap-1 text-slate-900 font-semibold hover:underline underline-offset-4">+ Başka kod üret</a>
    <span class="text-slate-300">·</span>
    <a href="/company/connections" class="text-slate-500 hover:text-slate-900 transition">Davet listesine dön</a>
  </div>
</div>

<script>
  function copyCode() {
    const code = <%- JSON.stringify(result.code) %>;
    navigator.clipboard.writeText(code).then(function () {
      document.getElementById('copyStatus').textContent = '✓';
    });
  }
</script>
