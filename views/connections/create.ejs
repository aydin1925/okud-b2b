<div class="max-w-xl mx-auto space-y-6">

  <a href="/company/connections" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    Davet Listesi
  </a>

  <div class="bg-white rounded-3xl shadow-soft-lg ring-1 ring-slate-900/5 p-5 sm:p-8">
    <div class="mb-8">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-700 text-white mb-4 shadow-lg shadow-blue-500/25">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" /></svg>
      </div>
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 mb-2">Yeni Davet</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Filoya <span class="font-serif italic text-slate-500">bir kişi ekle.</span></h2>
      <p class="text-slate-500 mt-2 text-sm">Sistem 8 karakterlik güvenli bir kod üretecek. Kodu şoför veya araç sahibine WhatsApp/SMS/e-posta ile iletir, karşıdaki hesabıyla girip kabul eder.</p>
    </div>

    <% if (error) { %>
      <div class="flex items-start gap-3 rounded-2xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 flex-shrink-0 mt-0.5"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 01.67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 11-.671-1.34l.041-.022zM12 9a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/company/connections/create" method="POST" class="space-y-5">
      <div>
        <label class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Kimi davet ediyorsun?</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="relative cursor-pointer">
            <input type="radio" name="target_type" value="driver_profile" <%= formData.target_type === 'driver_profile' ? 'checked' : '' %> class="peer sr-only" required>
            <div class="rounded-2xl ring-1 ring-slate-200 bg-white p-4 hover:ring-slate-300 peer-checked:ring-2 peer-checked:ring-slate-900 peer-checked:bg-slate-50 transition">
              <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <p class="font-bold text-slate-900 text-sm">Şoför</p>
              <p class="text-xs text-slate-500 mt-0.5">Ehliyet + SRC gerekli</p>
            </div>
          </label>
          <label class="relative cursor-pointer">
            <input type="radio" name="target_type" value="vehicle_profile" <%= formData.target_type === 'vehicle_profile' ? 'checked' : '' %> class="peer sr-only" required>
            <div class="rounded-2xl ring-1 ring-slate-200 bg-white p-4 hover:ring-slate-300 peer-checked:ring-2 peer-checked:ring-slate-900 peer-checked:bg-slate-50 transition">
              <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-sky-100 text-sky-600 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
              </div>
              <p class="font-bold text-slate-900 text-sm">Araç Sahibi</p>
              <p class="text-xs text-slate-500 mt-0.5">Ruhsat + Sigorta gerekli</p>
            </div>
          </label>
        </div>
      </div>

      <div>
        <label for="label" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Etiket <span class="text-slate-400 font-normal normal-case">(opsiyonel)</span></label>
        <input type="text" id="label" name="label" value="<%= formData.label || '' %>" maxlength="100" placeholder="örn: Ahmet'in kodu"
               class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
        <p class="text-xs text-slate-400 mt-1.5">Sadece sen görürsün, karşı tarafa gitmez.</p>
      </div>

      <div class="flex items-center gap-3 pt-3">
        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800 transition shadow-lg shadow-slate-900/25">
          Kod Üret
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </button>
        <a href="/company/connections" class="text-sm text-slate-500 hover:text-slate-900 transition font-medium">Vazgeç</a>
      </div>
    </form>
  </div>
</div>
