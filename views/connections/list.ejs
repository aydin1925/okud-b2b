<div class="space-y-6">

  <div class="flex items-start justify-between flex-wrap gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 mb-2">Filo Davetleri</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Bekleyen <span class="font-serif italic text-slate-500">kodlar</span>
      </h1>
      <p class="text-slate-500 mt-2"><%= currentCompany.name %> · aktif OTP davet kodları</p>
    </div>
    <a href="/company/connections/create"
       class="group inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-slate-800 transition shadow-lg shadow-slate-900/25">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Yeni Kod
    </a>
  </div>

  <% if (requests.length === 0) { %>
    <div class="relative overflow-hidden bg-gradient-to-br from-slate-50 to-blue-50 border border-slate-200 rounded-3xl p-12 text-center">
      <div class="absolute top-0 right-0 w-64 h-64 bg-blue-200/40 rounded-full blur-3xl"></div>
      <div class="relative">
        <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-white shadow-lg text-slate-400 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-7 w-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25" />
          </svg>
        </div>
        <p class="text-xl font-bold text-slate-800">Bekleyen davet kodu yok</p>
        <p class="text-slate-600 mt-1">Şoför veya araç sahibi eklemek için yeni kod üret.</p>
      </div>
    </div>
  <% } else { %>
    <div class="grid md:grid-cols-2 gap-3">
      <% requests.forEach(function(r) { %>
        <%
          const typeColor = r.target_type === 'driver_profile' ? 'from-emerald-500 to-emerald-700' : 'from-sky-500 to-sky-700';
          const typeBg = r.target_type === 'driver_profile' ? 'bg-emerald-100 text-emerald-700' : 'bg-sky-100 text-sky-700';
        %>
        <div class="relative overflow-hidden bg-white rounded-2xl shadow-soft ring-1 ring-slate-900/5 p-5">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Kod</p>
              <code class="text-2xl font-black tracking-widest text-slate-900 font-mono"><%= r.code %></code>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full <%= typeBg %> px-2.5 py-1 text-[11px] font-semibold">
              <%= typeLabels[r.target_type] || r.target_type %>
            </span>
          </div>
          <% if (r.label) { %>
            <p class="text-sm text-slate-600 mb-3 line-clamp-1"><em class="text-slate-400">Not:</em> <%= r.label %></p>
          <% } %>
          <div class="flex items-center justify-between gap-2 pt-3 border-t border-slate-100">
            <span class="text-xs text-slate-500 inline-flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <%= r.expires_at %>
            </span>
            <form action="/company/connections/<%= r.id %>/cancel" method="POST" class="inline"
                  data-confirm="Bu davet kodunu iptal etmek üzeresin. Karşı tarafa iletildiyse artık geçersiz olacak."
                  data-confirm-title="Kodu İptal Et"
                  data-confirm-button="Evet, iptal et"
                  data-confirm-danger>
              <button type="submit" class="rounded-lg bg-white ring-1 ring-red-200 text-red-600 hover:bg-red-50 px-3 py-1 text-xs font-semibold transition">
                İptal
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
