<div class="max-w-lg mx-auto space-y-5">

  <a href="/connections/redeem" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
    Farklı kod
  </a>

  <!-- Kurum hero -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 sm:p-8 shadow-2xl ring-1 ring-slate-900/10">
    <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl"></div>
    <div class="relative">
      <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-300 mb-3">Davet</p>
      <h2 class="text-2xl font-bold text-white tracking-tight leading-tight">
        <span class="font-serif italic text-indigo-200"><%= preview.company.name %></span><br>seni filosuna eklemek istiyor.
      </h2>
      <div class="flex items-center gap-2 mt-4 flex-wrap">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 backdrop-blur ring-1 ring-white/20 px-3 py-1 text-xs font-semibold text-white">
          Bağlantı türü: <%= typeLabels[preview.target_type] %>
        </span>
      </div>
      <% if (preview.request.label) { %>
        <p class="text-slate-400 text-xs mt-3">Kurum notu: <em class="text-slate-300"><%= preview.request.label %></em></p>
      <% } %>
    </div>
  </div>

  <% if (preview.target_type === 'driver_profile') { %>

    <% if (!preview.driverProfile) { %>
      <div class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-6">
        <div class="rounded-2xl bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm mb-4">
          Bu kodu kabul etmek için önce bir <strong>şoför profilin</strong> olmalı.
        </div>
        <a href="/driver/profile/create" class="inline-flex items-center gap-1 text-sm text-slate-900 font-semibold hover:underline underline-offset-4">Şoför profili oluştur →</a>
      </div>

    <% } else if (preview.driverProfile.status !== 'active') { %>
      <div class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-6">
        <div class="rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 text-sm mb-4">
          Şoför profilin <strong>aktif değil</strong>. Ehliyet ve SRC belgelerin onaylanmadan bir filoya katılamazsın.
        </div>
        <a href="/driver/profile" class="inline-flex items-center gap-1 text-sm text-slate-900 font-semibold hover:underline underline-offset-4">Belgelerimi gör →</a>
      </div>

    <% } else { %>
      <form action="/connections/redeem/confirm" method="POST" class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-6 space-y-5">
        <input type="hidden" name="code" value="<%= preview.request.code %>">

        <p class="text-sm text-slate-600">
          Devam etmek için aşağıdaki iki metni açıp okuduktan sonra kutuları işaretle.
        </p>

        <!-- KVKK -->
        <div class="rounded-2xl ring-1 ring-slate-200 p-4">
          <button type="button"
                  onclick="document.getElementById('kvkkDialog').showModal()"
                  class="group w-full flex items-center justify-between gap-3 text-left">
            <div class="flex items-center gap-3">
              <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-amber-100 text-amber-600 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="font-bold text-slate-900 truncate"><%= preview.kvkk.title %></p>
                <p class="text-xs text-slate-500">Aç, oku, kutuyu işaretle</p>
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-slate-400 group-hover:text-slate-900 transition flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
          <label class="flex items-start gap-2 text-sm text-slate-700 mt-3 pt-3 border-t border-slate-100">
            <input type="checkbox" name="kvkk_consent" class="mt-0.5 accent-slate-900">
            <span>Aydınlatma metnini okudum, bilgilendirildim.</span>
          </label>
        </div>

        <!-- Sözleşme -->
        <div class="rounded-2xl ring-1 ring-slate-200 p-4">
          <button type="button"
                  onclick="document.getElementById('contractDialog').showModal()"
                  class="group w-full flex items-center justify-between gap-3 text-left">
            <div class="flex items-center gap-3">
              <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 text-blue-600 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="font-bold text-slate-900 truncate"><%= preview.contract.title %></p>
                <p class="text-xs text-slate-500">Aç, oku, kutuyu işaretle</p>
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-slate-400 group-hover:text-slate-900 transition flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
          <label class="flex items-start gap-2 text-sm text-slate-700 mt-3 pt-3 border-t border-slate-100">
            <input type="checkbox" name="contract_consent" class="mt-0.5 accent-slate-900">
            <span>Sözleşmeyi okudum ve kabul ediyorum.</span>
          </label>
        </div>

        <button type="submit"
                class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3.5 text-sm font-bold text-white hover:bg-emerald-500 transition shadow-lg shadow-emerald-500/25">
          Onayla ve Filoya Katıl
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </button>
      </form>

      <form action="/connections/redeem/reject" method="POST"
            data-confirm="Bu filo katılım davetini reddetmek üzeresin. Kod bir daha kullanılamaz."
            data-confirm-title="Daveti Reddet"
            data-confirm-button="Evet, reddet"
            data-confirm-danger>
        <input type="hidden" name="code" value="<%= preview.request.code %>">
        <button type="submit"
                class="w-full inline-flex items-center justify-center gap-1 rounded-xl bg-white ring-1 ring-red-200 text-red-600 hover:bg-red-50 px-5 py-3 text-sm font-semibold transition">
          Daveti Reddet
        </button>
      </form>
    <% } %>

  <% } else { %>

    <% if (preview.vehicles.length === 0) { %>
      <div class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-6">
        <div class="rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 text-sm mb-4">
          <strong>Aktif (belgeleri onaylanmış)</strong> bir aracın yok. Önce araç ekleyip Ruhsat ve Sigorta belgelerini onaylatmalısın.
        </div>
        <a href="/vehicles" class="inline-flex items-center gap-1 text-sm text-slate-900 font-semibold hover:underline underline-offset-4">Araçlarım →</a>
      </div>

    <% } else { %>
      <form action="/connections/redeem/confirm" method="POST" class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-6 space-y-5">
        <input type="hidden" name="code" value="<%= preview.request.code %>">

        <div>
          <label for="vehicle_id" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Hangi aracı bağlamak istersin?</label>
          <select id="vehicle_id" name="vehicle_id" required
                  class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
            <option value="">Araç seç</option>
            <% preview.vehicles.forEach(function(v) { %>
              <option value="<%= v.id %>"><%= v.plate_number %> — <%= v.brand %> <%= v.model %></option>
            <% }); %>
          </select>
        </div>

        <div class="rounded-2xl ring-1 ring-slate-200 p-4">
          <button type="button" onclick="document.getElementById('kvkkDialog').showModal()" class="group w-full flex items-center justify-between gap-3 text-left">
            <div class="flex items-center gap-3">
              <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-amber-100 text-amber-600 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="font-bold text-slate-900 truncate"><%= preview.kvkk.title %></p>
                <p class="text-xs text-slate-500">Aç, oku, kutuyu işaretle</p>
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-slate-400 group-hover:text-slate-900 transition flex-shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          </button>
          <label class="flex items-start gap-2 text-sm text-slate-700 mt-3 pt-3 border-t border-slate-100">
            <input type="checkbox" name="kvkk_consent" class="mt-0.5 accent-slate-900">
            <span>Aydınlatma metnini okudum, bilgilendirildim.</span>
          </label>
        </div>

        <div class="rounded-2xl ring-1 ring-slate-200 p-4">
          <button type="button" onclick="document.getElementById('contractDialog').showModal()" class="group w-full flex items-center justify-between gap-3 text-left">
            <div class="flex items-center gap-3">
              <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 text-blue-600 flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="font-bold text-slate-900 truncate"><%= preview.contract.title %></p>
                <p class="text-xs text-slate-500">Aç, oku, kutuyu işaretle</p>
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-slate-400 group-hover:text-slate-900 transition flex-shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          </button>
          <label class="flex items-start gap-2 text-sm text-slate-700 mt-3 pt-3 border-t border-slate-100">
            <input type="checkbox" name="contract_consent" class="mt-0.5 accent-slate-900">
            <span>Sözleşmeyi okudum ve kabul ediyorum.</span>
          </label>
        </div>

        <button type="submit"
                class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3.5 text-sm font-bold text-white hover:bg-emerald-500 transition shadow-lg shadow-emerald-500/25">
          Onayla ve Filoya Katıl
        </button>
      </form>

      <form action="/connections/redeem/reject" method="POST"
            data-confirm="Bu filo katılım davetini reddetmek üzeresin. Kod bir daha kullanılamaz."
            data-confirm-title="Daveti Reddet"
            data-confirm-button="Evet, reddet"
            data-confirm-danger>
        <input type="hidden" name="code" value="<%= preview.request.code %>">
        <button type="submit" class="w-full inline-flex items-center justify-center gap-1 rounded-xl bg-white ring-1 ring-red-200 text-red-600 hover:bg-red-50 px-5 py-3 text-sm font-semibold transition">
          Daveti Reddet
        </button>
      </form>
    <% } %>

  <% } %>
</div>

<!-- Modals -->
<dialog id="kvkkDialog" class="rounded-3xl p-0 w-full max-w-2xl backdrop:bg-slate-900/60">
  <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4 sticky top-0 bg-white rounded-t-3xl">
    <h3 class="text-lg font-bold text-slate-900"><%= preview.kvkk.title %></h3>
    <button type="button" onclick="document.getElementById('kvkkDialog').close()" class="inline-flex h-8 w-8 items-center justify-center rounded-full text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
  <div class="px-6 py-5 max-h-[70vh] overflow-auto whitespace-pre-line text-sm text-slate-700 leading-relaxed font-serif">
<%= preview.kvkk.content %>
  </div>
</dialog>

<dialog id="contractDialog" class="rounded-3xl p-0 w-full max-w-2xl backdrop:bg-slate-900/60">
  <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4 sticky top-0 bg-white rounded-t-3xl">
    <h3 class="text-lg font-bold text-slate-900"><%= preview.contract.title %></h3>
    <button type="button" onclick="document.getElementById('contractDialog').close()" class="inline-flex h-8 w-8 items-center justify-center rounded-full text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
  <div class="px-6 py-5 max-h-[70vh] overflow-auto whitespace-pre-line text-sm text-slate-700 leading-relaxed font-serif">
<%= preview.contract.content %>
  </div>
</dialog>
