<%
  const stMap = {
    pending_docs: { label: 'Belge bekleniyor', ring: 'ring-amber-400/50', dot: 'bg-amber-400', glow: 'shadow-amber-500/20' },
    active:       { label: 'Aktif',            ring: 'ring-emerald-400/50', dot: 'bg-emerald-400', glow: 'shadow-emerald-500/20' },
    inactive:     { label: 'Pasif',            ring: 'ring-slate-400/50', dot: 'bg-slate-400', glow: 'shadow-slate-500/10' },
  };
  const st = stMap[vehicle.status] || stMap.inactive;
  const vehicleTypeLabels = { minibus: 'Minibüs', midibus: 'Midibüs', otobus: 'Otobüs', van: 'Van', binek: 'Binek Araç' };
  const typeLabel = vehicleTypeLabels[vehicle.vehicle_type] || vehicle.vehicle_type;
%>

<div class="space-y-6">

  <a href="/vehicles" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    Araçlarım
  </a>

  <!-- HERO — plaka odaklı -->
  <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 shadow-2xl ring-1 ring-slate-900/10">
    <!-- Dekoratif -->
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-sky-500/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-blue-500/15 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(rgba(255,255,255,.7) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.7) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <!-- Sağ üstte büyük araç ikonu -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="absolute -top-4 -right-4 h-56 w-56 text-white/5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
    </svg>

    <div class="relative p-6 sm:p-10">
      <!-- Üst şerit: badge + tip + düzenle -->
      <div class="flex items-center justify-between gap-3 mb-8 flex-wrap">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur ring-1 ring-white/20 px-3 py-1">
          <span class="h-1.5 w-1.5 rounded-full <%= st.dot %>"></span>
          <span class="text-xs font-bold text-white uppercase tracking-widest"><%= st.label %></span>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 backdrop-blur ring-1 ring-white/20 px-3 py-1 text-xs font-semibold text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
            <%= typeLabel %>
          </span>
          <a href="/vehicles/<%= vehicle.id %>/edit" class="inline-flex items-center gap-1.5 rounded-full bg-white/10 backdrop-blur ring-1 ring-white/20 px-3 py-1.5 text-xs font-bold text-white hover:bg-white/20 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" /></svg>
            Düzenle
          </a>
        </div>
      </div>

      <% if (pendingRequest) { %>
        <div class="mb-6 rounded-2xl bg-amber-500/10 backdrop-blur ring-1 ring-amber-400/30 px-4 py-3 flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-amber-300 flex-shrink-0 mt-0.5"><path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-amber-200">Bekleyen değişiklik talebin var</p>
            <p class="text-xs text-amber-100/80 mt-0.5">SuperAdmin inceleyip karar verecek. Sonucu araç sayfasında görürsün.</p>
          </div>
          <form action="/vehicles/<%= vehicle.id %>/updates/<%= pendingRequest.id %>/cancel" method="POST"
                data-confirm="Bekleyen değişiklik talebini iptal etmek üzeresin."
                data-confirm-button="Evet, iptal et" data-confirm-danger>
            <button type="submit" class="rounded-lg bg-white/10 hover:bg-white/20 text-white px-3 py-1 text-xs font-semibold transition">
              İptal Et
            </button>
          </form>
        </div>
      <% } %>

      <!-- Plaka: gerçek plaka görünümlü -->
      <div class="inline-flex items-stretch rounded-2xl overflow-hidden shadow-2xl <%= st.glow %> ring-1 ring-white/10 mb-6">
        <!-- Sol mavi Türkiye şeridi -->
        <div class="w-8 bg-gradient-to-b from-blue-600 to-blue-800 flex flex-col items-center justify-center py-2">
          <span class="text-white text-[10px] font-black tracking-widest">TR</span>
        </div>
        <!-- Plaka -->
        <div class="bg-white px-6 py-4">
          <span class="text-slate-900 text-3xl sm:text-4xl md:text-5xl font-black tracking-widest font-mono"><%= vehicle.plate_number %></span>
        </div>
      </div>

      <h1 class="text-white text-3xl sm:text-4xl font-bold tracking-tight">
        <%= vehicle.brand %> <span class="font-serif italic text-slate-400"><%= vehicle.model %></span>
      </h1>
      <p class="text-slate-400 mt-1"><%= vehicle.year %> model · <%= vehicle.capacity %> yolcu kapasiteli</p>

      <% if (vehicle.notes) { %>
        <div class="mt-6 rounded-2xl bg-white/5 backdrop-blur ring-1 ring-white/10 px-4 py-3">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Not</p>
          <p class="text-sm text-slate-200"><%= vehicle.notes %></p>
        </div>
      <% } %>
    </div>

    <!-- Alt strip: metrikler -->
    <div class="relative border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 sm:divide-x divide-white/10">
      <div class="p-4 sm:p-5 border-b sm:border-b-0 border-white/10">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Marka</p>
        <p class="text-white font-bold text-sm mt-1 truncate"><%= vehicle.brand %></p>
      </div>
      <div class="p-4 sm:p-5 border-b sm:border-b-0 border-white/10">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Model</p>
        <p class="text-white font-bold text-sm mt-1 truncate"><%= vehicle.model %></p>
      </div>
      <div class="p-4 sm:p-5">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Yıl</p>
        <p class="text-white font-bold text-sm mt-1"><%= vehicle.year %></p>
      </div>
      <div class="p-4 sm:p-5">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Kapasite</p>
        <p class="text-white font-bold text-sm mt-1"><%= vehicle.capacity %> kişi</p>
      </div>
    </div>
  </div>

  <!-- Belgeler -->
  <div class="grid md:grid-cols-2 gap-4">
    <% requiredTypes.forEach(function(type) { %>
      <% const doc = documentsByType[type];
         let barColor = 'from-red-400 to-red-600', stLabel = 'Yüklenmedi', stBg = 'bg-red-50 text-red-700', stDot = 'bg-red-500';
         if (doc) {
           if (doc.verification_status === 'pending')  { barColor = 'from-amber-400 to-amber-600'; stLabel = 'Onay bekliyor'; stBg = 'bg-amber-50 text-amber-700'; stDot = 'bg-amber-500'; }
           if (doc.verification_status === 'verified') { barColor = 'from-emerald-400 to-emerald-600'; stLabel = 'Onaylandı'; stBg = 'bg-emerald-50 text-emerald-700'; stDot = 'bg-emerald-500'; }
           if (doc.verification_status === 'rejected') { barColor = 'from-red-400 to-red-600'; stLabel = 'Reddedildi'; stBg = 'bg-red-50 text-red-700'; stDot = 'bg-red-500'; }
         }
      %>
      <div class="relative overflow-hidden bg-white rounded-2xl shadow-soft ring-1 ring-slate-900/5 p-5">
        <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b <%= barColor %>"></div>
        <div class="pl-4">
          <div class="flex items-start justify-between gap-3 mb-3">
            <p class="font-bold text-slate-900"><%= typeLabels[type] %></p>
            <span class="inline-flex items-center gap-1 rounded-full <%= stBg %> px-2.5 py-0.5 text-[11px] font-bold">
              <span class="h-1.5 w-1.5 rounded-full <%= stDot %>"></span>
              <%= stLabel %>
            </span>
          </div>
          <% if (doc) { %>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Yükleme</p>
                <p class="text-slate-700 font-semibold mt-0.5"><%= doc.created_at %></p>
              </div>
              <% if (doc.expires_at) { %>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Son Geç.</p>
                  <p class="text-slate-700 font-semibold mt-0.5"><%= doc.expires_at %></p>
                </div>
              <% } %>
            </div>
            <% if (doc.rejection_reason) { %>
              <p class="mt-2 text-xs text-red-600 rounded-md bg-red-50 px-2 py-1"><em>Gerekçe:</em> <%= doc.rejection_reason %></p>
            <% } %>
          <% } else { %>
            <p class="text-xs text-slate-500">Bu belgeyi henüz yüklemedin</p>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- Yükleme -->
  <div class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-6">
    <div class="flex items-center gap-3 mb-5">
      <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-sky-500 to-sky-700 text-white shadow-lg shadow-sky-500/25">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" /></svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-slate-900">Belge Yükle</h3>
        <p class="text-xs text-slate-500">JPG, PNG, WEBP veya PDF · Max 5 MB</p>
      </div>
    </div>

    <form action="/vehicles/<%= vehicle.id %>/documents/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="document_type" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Belge Türü</label>
          <select id="document_type" name="document_type" required
                  class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
            <option value="">Seçiniz</option>
            <% requiredTypes.forEach(function(type) { %>
              <option value="<%= type %>"><%= typeLabels[type] %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="expires_at" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Son Geçerlilik <span class="text-slate-400 font-normal normal-case">(opsiyonel)</span></label>
          <input type="date" id="expires_at" name="expires_at"
                 class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
        </div>
      </div>
      <div>
        <label for="file" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Dosya</label>
        <input type="file" id="file" name="file" accept=".jpg,.jpeg,.png,.webp,.pdf" required
               class="w-full text-sm text-slate-600 file:mr-3 file:rounded-xl file:border-0 file:bg-slate-900 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-white hover:file:bg-slate-800 file:transition file:cursor-pointer">
      </div>
      <button type="submit"
              class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800 transition shadow-lg shadow-slate-900/25">
        Yükle
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" /></svg>
      </button>
    </form>
  </div>
</div>
