<div class="max-w-3xl mx-auto space-y-6">

  <a href="/company/contracts" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    Sözleşmelerim
  </a>

  <div class="bg-white rounded-3xl shadow-soft-lg ring-1 ring-slate-900/5 p-6 sm:p-8">
    <div class="flex items-start justify-between gap-3 mb-6">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2">Düzenle</p>
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight"><%= typeLabels[template.type] %></h2>
        <p class="text-slate-500 text-sm mt-2"><%= currentCompany.name %></p>
      </div>
      <% if (template.source === 'custom') { %>
        <span class="inline-flex items-center gap-1 rounded-full bg-blue-100 text-blue-700 px-3 py-1 text-xs font-bold uppercase tracking-widest">Özel</span>
      <% } else { %>
        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 text-slate-600 px-3 py-1 text-xs font-bold uppercase tracking-widest">Standart</span>
      <% } %>
    </div>

    <% if (template.source === 'default') { %>
      <div class="rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 text-sm mb-5 flex items-start gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 flex-shrink-0 mt-0.5"><path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
        <span>Şu an sistemin <strong>varsayılan metni</strong> kullanılıyor. Aşağıdaki alanları düzenleyip kaydettiğinde bu kuruma özel bir versiyon oluşacak.</span>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="flex items-start gap-3 rounded-2xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 flex-shrink-0 mt-0.5"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 01.67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 11-.671-1.34l.041-.022zM12 9a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/company/contracts/<%= template.type %>" method="POST" class="space-y-5">
      <div>
        <label for="title" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Başlık</label>
        <input type="text" id="title" name="title" value="<%= formData.title || '' %>" maxlength="200" required
               class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
      </div>

      <div>
        <label for="content" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Sözleşme Metni</label>
        <textarea id="content" name="content" rows="20" maxlength="20000" required
                  class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-slate-50 px-4 py-4 text-sm text-slate-800 font-serif leading-relaxed whitespace-pre resize-none focus:ring-2 focus:ring-slate-900 focus:bg-white focus:outline-none transition"><%= formData.content || '' %></textarea>
        <p class="text-xs text-slate-400 mt-1.5">Serif font, satır sonları korunur. Max 20.000 karakter.</p>
      </div>

      <div class="flex items-center gap-3 pt-3">
        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800 transition shadow-lg shadow-slate-900/25">
          Kaydet
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
        </button>
        <a href="/company/contracts" class="text-sm text-slate-500 hover:text-slate-900 transition font-medium">Vazgeç</a>
      </div>
    </form>

    <div class="mt-8 pt-6 border-t border-slate-100 flex items-start gap-2 text-xs text-slate-500">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-slate-300 flex-shrink-0 mt-0.5"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
      Kaydettiğinizde, bundan sonra filoya katılan üyeler yeni metni görecek. Önceki kabuller kendi metinlerini koruyacak.
    </div>
  </div>
</div>
