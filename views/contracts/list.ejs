<%
  const driverTemplates      = templates.filter(t => t.type === 'driver' || t.type === 'driver_kvkk');
  const vehicleTemplates     = templates.filter(t => t.type === 'vehicle_owner' || t.type === 'vehicle_owner_kvkk');
  const partnershipTemplates = templates.filter(t => t.type === 'partnership');
%>

<div class="space-y-6 sm:space-y-8">

  <div>
    <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2">Sözleşmelerim</p>
    <h1 class="text-2xl sm:text-4xl font-bold text-slate-900 tracking-tight">
      Kurumsal <span class="font-serif italic text-slate-500">metinler</span>
    </h1>
    <p class="text-slate-500 mt-2"><%= currentCompany.name %> · filoya katılanların onaylayacağı belgeler</p>
  </div>

  <div class="flex items-start gap-3 rounded-2xl bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200/60 px-5 py-4">
    <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 text-blue-600 flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
    </div>
    <p class="text-sm text-blue-900">
      Bir sözleşmeyi düzenlediğinde, <strong>bundan sonraki katılımlar</strong> yeni metni görecek. Önceki kabuller kendi metinlerini olduğu gibi koruyacak — hukuki iz her zaman kabul anındaki metne bağlıdır.
    </p>
  </div>

  <!-- ŞOFÖRLER -->
  <div>
    <div class="flex items-center gap-2 mb-4">
      <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900">Şoförler İçin</h3>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      <% driverTemplates.forEach(function(t) { %><%- include('_card', { t, typeLabels }) %><% }); %>
    </div>
  </div>

  <!-- ARAÇ SAHİPLERİ -->
  <div>
    <div class="flex items-center gap-2 mb-4">
      <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-sky-100 text-sky-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900">Araç Sahipleri İçin</h3>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      <% vehicleTemplates.forEach(function(t) { %><%- include('_card', { t, typeLabels }) %><% }); %>
    </div>
  </div>

  <!-- İŞ ORTAKLIKLARI -->
  <div>
    <div class="flex items-center gap-2 mb-4">
      <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-purple-100 text-purple-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21" /></svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900">Kurum-Kurum İş Ortaklıkları</h3>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      <% partnershipTemplates.forEach(function(t) { %><%- include('_card', { t, typeLabels }) %><% }); %>
    </div>
  </div>
</div>
