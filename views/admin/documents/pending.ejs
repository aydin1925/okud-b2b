<div class="space-y-6">

  <a href="/admin" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    Admin Panel
  </a>

  <div class="flex items-start justify-between flex-wrap gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-amber-600 mb-2">Belge Onayları</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Onay <span class="font-serif italic text-slate-500">bekleyen</span> belgeler
      </h1>
      <p class="text-slate-500 mt-2">Şoför ve araç sahiplerinin yüklediği belgeleri incele.</p>
    </div>
    <% if (documents.length > 0) { %>
      <div class="inline-flex items-center gap-2 rounded-2xl bg-amber-50 border border-amber-200 px-4 py-2">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500 text-white text-sm font-bold"><%= documents.length %></span>
        <span class="text-sm font-semibold text-amber-800">belge bekliyor</span>
      </div>
    <% } %>
  </div>

  <% if (documents.length === 0) { %>
    <div class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-16 text-center">
      <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-600 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-8 w-8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-xl font-bold text-slate-800">Hepsi temiz</p>
      <p class="text-slate-500 mt-1">Şu anda onay bekleyen belge yok. 🎉</p>
    </div>
  <% } else { %>
    <div class="space-y-3">
      <% documents.forEach(function(doc) { %>
        <div class="bg-white rounded-2xl shadow-soft ring-1 ring-slate-900/5 hover:ring-slate-900/10 hover:shadow-soft-lg transition p-5">
          <div class="flex items-start gap-4 flex-wrap">

            <!-- Icon -->
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-slate-100 to-slate-200 text-slate-700 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>

            <!-- İçerik -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-1.5">
                <p class="font-bold text-slate-900"><%= typeLabels[doc.document_type] || doc.document_type %></p>
                <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">
                  Bekliyor
                </span>
                <span class="text-xs text-slate-400">·  #<%= doc.id %></span>
              </div>
              <div class="text-sm text-slate-600">
                <span class="font-semibold text-slate-800"><%= doc.first_name %> <%= doc.last_name %></span>
                <span class="text-slate-400"> · </span>
                <span class="text-slate-500"><%= doc.email %></span>
              </div>
              <div class="mt-2 flex items-center gap-4 text-xs text-slate-500 flex-wrap">
                <span class="inline-flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                  <%= doc.created_at %>
                </span>
                <% if (doc.expires_at) { %>
                  <span class="inline-flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Son: <%= doc.expires_at %>
                  </span>
                <% } %>
                <span class="inline-flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                  <%= Math.round(doc.file_size / 1024) %> KB · <%= doc.owner_type %>#<%= doc.owner_id %>
                </span>
              </div>
            </div>

            <!-- Aksiyonlar -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 w-full sm:w-auto sm:ml-auto">
              <form action="/admin/documents/<%= doc.id %>/verify" method="POST" class="inline">
                <button type="submit"
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-1 rounded-lg bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-emerald-500 transition shadow-lg shadow-emerald-500/25">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  Onayla
                </button>
              </form>
              <form action="/admin/documents/<%= doc.id %>/reject" method="POST" class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-1.5 w-full sm:w-auto">
                <input type="text" name="reason" placeholder="Red gerekçesi" required
                       class="rounded-lg border-0 ring-1 ring-slate-200 bg-slate-50 px-3 py-2 text-xs w-full sm:w-40 focus:ring-2 focus:ring-red-500 focus:bg-white focus:outline-none transition">
                <button type="submit"
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-1 rounded-lg bg-red-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-red-500 transition shadow-lg shadow-red-500/25">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  Reddet
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
