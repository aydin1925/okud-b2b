<div class="space-y-6">

  <a href="/admin" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    Admin Panel
  </a>

  <div class="flex items-start justify-between flex-wrap gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 mb-2">Kurum Onayları</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Onay <span class="font-serif italic text-slate-500">bekleyen</span> kurumlar
      </h1>
      <p class="text-slate-500 mt-2">Yeni oluşturulmuş kurumlar. Onayladığında sistemde aktif çalışmaya başlar.</p>
    </div>
    <% if (companies.length > 0) { %>
      <div class="inline-flex items-center gap-2 rounded-2xl bg-blue-50 border border-blue-200 px-4 py-2">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-500 text-white text-sm font-bold"><%= companies.length %></span>
        <span class="text-sm font-semibold text-blue-800">kurum bekliyor</span>
      </div>
    <% } %>
  </div>

  <% if (companies.length === 0) { %>
    <div class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-16 text-center">
      <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-600 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-8 w-8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </div>
      <p class="text-xl font-bold text-slate-800">Hepsi temiz</p>
      <p class="text-slate-500 mt-1">Şu an bekleyen kurum yok.</p>
    </div>
  <% } else { %>
    <div class="space-y-3">
      <% companies.forEach(function(c) { %>
        <div class="bg-white rounded-2xl shadow-soft ring-1 ring-slate-900/5 hover:ring-slate-900/10 hover:shadow-soft-lg transition overflow-hidden">
          <div class="p-5 flex items-start gap-4 flex-wrap">
            <!-- Kurum avatar -->
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-slate-100 to-slate-200 text-slate-700 font-black text-lg flex-shrink-0">
              <%= (c.name || '?').trim()[0].toUpperCase() %>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <p class="font-bold text-slate-900 text-lg"><%= c.name %></p>
                <span class="inline-flex items-center gap-1 rounded-full <%= c.company_type === 'provider' ? 'bg-blue-100 text-blue-700' : 'bg-emerald-100 text-emerald-700' %> px-2.5 py-0.5 text-[11px] font-bold">
                  <%= c.company_type === 'provider' ? 'Hizmet Sağlayıcı' : 'Hizmet Alan' %>
                </span>
              </div>
              <div class="grid sm:grid-cols-2 gap-x-6 gap-y-1 text-sm mt-2">
                <div class="text-slate-500">
                  <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Vergi No</span>
                  <p class="font-mono font-semibold text-slate-700"><%= c.tax_number %></p>
                </div>
                <div class="text-slate-500">
                  <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Oluşturan</span>
                  <p class="font-semibold text-slate-700"><%= c.admin_first_name %> <%= c.admin_last_name %></p>
                  <p class="text-xs text-slate-500"><%= c.admin_email %></p>
                </div>
              </div>
              <p class="text-[11px] text-slate-400 mt-2">Kayıt: <%= c.created_at %></p>
            </div>
          </div>

          <div class="p-5 border-t border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center gap-3">
            <form action="/admin/companies/<%= c.id %>/approve" method="POST" class="inline"
                  data-confirm="Bu kurumu onaylıyorsun. Aktif hale gelecek ve tüm yönetim araçlarına erişim açılacak."
                  data-confirm-title="Kurumu Onayla" data-confirm-button="Evet, onayla">
              <button type="submit"
                      class="w-full sm:w-auto inline-flex items-center justify-center gap-1 rounded-lg bg-emerald-600 px-4 py-2 text-xs font-bold text-white hover:bg-emerald-500 transition shadow-lg shadow-emerald-500/25">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                Onayla
              </button>
            </form>
            <form action="/admin/companies/<%= c.id %>/reject" method="POST" class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-1.5 w-full sm:w-auto">
              <input type="text" name="reason" placeholder="Red gerekçesi" required
                     class="rounded-lg border-0 ring-1 ring-slate-200 bg-white px-3 py-2 text-xs w-full sm:w-52 focus:ring-2 focus:ring-red-500 focus:outline-none transition">
              <button type="submit"
                      class="w-full sm:w-auto inline-flex items-center justify-center gap-1 rounded-lg bg-red-600 px-4 py-2 text-xs font-bold text-white hover:bg-red-500 transition shadow-lg shadow-red-500/25">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                Reddet
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
