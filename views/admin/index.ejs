<div class="space-y-8">

  <!-- HERO -->
  <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-violet-950 via-slate-900 to-slate-950 p-6 sm:p-8 shadow-2xl ring-1 ring-slate-900/10">
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-violet-500/25 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-purple-500/15 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.7) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.7) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative flex items-start justify-between gap-6 flex-wrap">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur ring-1 ring-white/20 px-3 py-1 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 text-violet-300"><path fill-rule="evenodd" d="M11.484 2.17a.75.75 0 011.032 0 11.209 11.209 0 007.877 3.08.75.75 0 01.722.515 12.74 12.74 0 01.635 3.985c0 5.942-4.064 10.933-9.563 12.348a.75.75 0 01-.374 0C6.314 20.683 2.25 15.692 2.25 9.75c0-1.39.223-2.73.635-3.985a.75.75 0 01.722-.516l.143.001c2.996 0 5.718-1.17 7.734-3.08z" clip-rule="evenodd" /></svg>
          <span class="text-xs font-bold uppercase tracking-widest text-violet-100">SuperAdmin</span>
        </div>
        <h1 class="text-white text-5xl font-bold tracking-tighter leading-[1.05]">
          Onay <span class="font-serif italic text-violet-300">merkezi.</span>
        </h1>
        <p class="text-slate-300 mt-3">Sistemin sağlığını buradan yönetiyorsun. Bekleyen ne varsa aşağıda.</p>
      </div>
      <!-- Toplam bekleyen -->
      <div class="text-right">
        <p class="text-[10px] font-bold uppercase tracking-widest text-violet-300">Toplam Bekleyen</p>
        <p class="text-white text-4xl sm:text-5xl md:text-6xl font-black tabular-nums tracking-tighter mt-1"><%= counts.total %></p>
      </div>
    </div>
  </div>

  <!-- Onay kartları -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <!-- Belgeler -->
    <a href="/admin/documents/pending" class="group relative overflow-hidden bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 hover:ring-slate-900/15 hover:shadow-soft-xl transition p-6">
      <div class="absolute -top-8 -right-8 w-40 h-40 bg-amber-100 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
      <div class="relative">
        <div class="flex items-start justify-between gap-3 mb-4">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 text-white shadow-lg shadow-amber-500/30">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
          </div>
          <% if (counts.documents > 0) { %>
            <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 text-amber-800 px-2.5 py-0.5 text-xs font-bold tabular-nums"><%= counts.documents %></span>
          <% } %>
        </div>
        <p class="font-bold text-slate-900 text-lg">Belge Onayları</p>
        <p class="text-sm text-slate-500 mt-1">Ehliyet, SRC, ruhsat, sigorta</p>
        <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500">
            <% if (counts.documents === 0) { %>Tümü onaylı<% } else { %><%= counts.documents %> belge bekliyor<% } %>
          </span>
          <span class="inline-flex items-center gap-1 text-sm font-bold text-slate-700 group-hover:text-slate-900 group-hover:translate-x-0.5 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </span>
        </div>
      </div>
    </a>

    <!-- Kurumlar -->
    <a href="/admin/companies" class="group relative overflow-hidden bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 hover:ring-slate-900/15 hover:shadow-soft-xl transition p-6">
      <div class="absolute -top-8 -right-8 w-40 h-40 bg-blue-100 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
      <div class="relative">
        <div class="flex items-start justify-between gap-3 mb-4">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-indigo-700 text-white shadow-lg shadow-blue-500/30">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>
          </div>
          <% if (counts.companies > 0) { %>
            <span class="inline-flex items-center gap-1 rounded-full bg-blue-100 text-blue-800 px-2.5 py-0.5 text-xs font-bold tabular-nums"><%= counts.companies %></span>
          <% } %>
        </div>
        <p class="font-bold text-slate-900 text-lg">Kurum Onayları</p>
        <p class="text-sm text-slate-500 mt-1">Yeni oluşturulan kurumlar</p>
        <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500">
            <% if (counts.companies === 0) { %>Tümü onaylı<% } else { %><%= counts.companies %> kurum bekliyor<% } %>
          </span>
          <span class="inline-flex items-center gap-1 text-sm font-bold text-slate-700 group-hover:text-slate-900 group-hover:translate-x-0.5 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </span>
        </div>
      </div>
    </a>

    <!-- Şoför profil değişiklikleri -->
    <a href="/admin/driver-updates" class="group relative overflow-hidden bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 hover:ring-slate-900/15 hover:shadow-soft-xl transition p-6">
      <div class="absolute -top-8 -right-8 w-40 h-40 bg-emerald-100 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
      <div class="relative">
        <div class="flex items-start justify-between gap-3 mb-4">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-700 text-white shadow-lg shadow-emerald-500/30">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <% if (counts.driverUpdates > 0) { %>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 text-emerald-800 px-2.5 py-0.5 text-xs font-bold tabular-nums"><%= counts.driverUpdates %></span>
          <% } %>
        </div>
        <p class="font-bold text-slate-900 text-lg">Şoför Değişiklikleri</p>
        <p class="text-sm text-slate-500 mt-1">Hassas alan talepleri</p>
        <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500">
            <% if (counts.driverUpdates === 0) { %>Bekleyen yok<% } else { %><%= counts.driverUpdates %> talep bekliyor<% } %>
          </span>
          <span class="inline-flex items-center gap-1 text-sm font-bold text-slate-700 group-hover:text-slate-900 group-hover:translate-x-0.5 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </span>
        </div>
      </div>
    </a>

    <!-- Araç değişiklikleri -->
    <a href="/admin/vehicle-updates" class="group relative overflow-hidden bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 hover:ring-slate-900/15 hover:shadow-soft-xl transition p-6">
      <div class="absolute -top-8 -right-8 w-40 h-40 bg-sky-100 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
      <div class="relative">
        <div class="flex items-start justify-between gap-3 mb-4">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-sky-500 to-sky-700 text-white shadow-lg shadow-sky-500/30">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
          </div>
          <% if (counts.vehicleUpdates > 0) { %>
            <span class="inline-flex items-center gap-1 rounded-full bg-sky-100 text-sky-800 px-2.5 py-0.5 text-xs font-bold tabular-nums"><%= counts.vehicleUpdates %></span>
          <% } %>
        </div>
        <p class="font-bold text-slate-900 text-lg">Araç Değişiklikleri</p>
        <p class="text-sm text-slate-500 mt-1">Plaka, marka, kapasite vb.</p>
        <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500">
            <% if (counts.vehicleUpdates === 0) { %>Bekleyen yok<% } else { %><%= counts.vehicleUpdates %> talep bekliyor<% } %>
          </span>
          <span class="inline-flex items-center gap-1 text-sm font-bold text-slate-700 group-hover:text-slate-900 group-hover:translate-x-0.5 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </span>
        </div>
      </div>
    </a>

  </div>

</div>
