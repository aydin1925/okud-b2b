<style>
  /* Dashboard'a özel */
  .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 900px) { .metrics { grid-template-columns: repeat(2, 1fr); } }
  .m-card {
    background: var(--surface); border-radius: var(--radius);
    box-shadow: var(--shadow-md); padding: 18px 20px 14px;
    transition: box-shadow 200ms var(--ease), transform 200ms var(--ease);
    position: relative;
  }
  .m-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-1px); }
  .m-card .head-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .m-card .lbl { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); font-weight: 500; }
  .m-card .icn {
    width: 26px; height: 26px; border-radius: 6px;
    background: var(--surface-2); color: var(--ink-3);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .m-card .icn svg { width: 13px; height: 13px; stroke-width: 2; }
  .m-card .val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 30px; font-weight: 600; letter-spacing: -0.04em;
    line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums;
  }
  .m-card .val .u { font-size: 14px; color: var(--ink-4); font-weight: 500; margin-left: 2px; }
  .m-card .footer {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line);
  }
  .m-card .note {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11.5px; color: var(--ink-3); font-weight: 500;
  }
  .m-card .note.good { color: var(--good); }

  /* Priorities */
  .prio-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  @media (max-width: 900px) { .prio-grid { grid-template-columns: 1fr; } }
  .prio-card {
    background: var(--surface); border-radius: var(--radius);
    box-shadow: var(--shadow-md); padding: 20px 22px;
    display: block;
    transition: box-shadow 220ms var(--ease), transform 220ms var(--ease);
  }
  .prio-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); }
  .prio-card .icn-box {
    width: 32px; height: 32px; border-radius: 7px;
    display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px;
  }
  .prio-card.accent .icn-box { background: var(--accent-soft); color: var(--accent); }
  .prio-card.good .icn-box { background: var(--good-soft); color: var(--good); }
  .prio-card.blue .icn-box { background: var(--blue-soft); color: var(--blue); }
  .prio-card .icn-box svg { width: 15px; height: 15px; stroke-width: 2; }
  .prio-card .top-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
  .prio-card .lbl { font-size: 11.5px; color: var(--ink-3); font-weight: 500; }
  .prio-card .value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 32px; font-weight: 600; letter-spacing: -0.04em;
    line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; margin-top: 6px;
  }
  .prio-card.accent .value { color: var(--accent); }
  .prio-card.good .value { color: var(--good); }
  .prio-card .desc { font-size: 13px; color: var(--ink-3); line-height: 1.5; margin-top: 8px; }
  .prio-card .desc strong { color: var(--ink-2); font-weight: 500; }
  .prio-card .go-arrow { color: var(--ink-4); transition: color 150ms var(--ease), transform 200ms var(--ease); }
  .prio-card:hover .go-arrow { color: var(--ink); transform: translateX(3px); }
  .prio-card .go-arrow svg { width: 14px; height: 14px; stroke-width: 2; }

  /* Row */
  .row-split { display: grid; grid-template-columns: 1.6fr 1fr; gap: 12px; }
  @media (max-width: 900px) { .row-split { grid-template-columns: 1fr; } }

  /* Brief */
  .brief-lead {
    font-size: 18px; font-weight: 500; letter-spacing: -0.02em;
    line-height: 1.45; color: var(--ink); margin-bottom: 14px;
  }
  .brief-lead .num { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }
  .brief-lead .u {
    display: inline-flex; align-items: center; gap: 3px;
    color: var(--good); font-weight: 600;
    font-family: 'JetBrains Mono', monospace; font-size: 14px;
    padding: 1px 6px; background: var(--good-soft);
    border-radius: 4px; letter-spacing: -0.02em; vertical-align: 1px;
  }
  .brief-para { font-size: 14px; line-height: 1.65; color: var(--ink-3); margin: 0 0 20px; }
  .brief-para .num { font-weight: 600; color: var(--ink); font-family: 'JetBrains Mono', monospace; }
  .sa .brief-cta {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 13px; font-weight: 500; color: white;
    padding: 8px 14px; background: var(--ink); border-radius: 6px;
    box-shadow: 0 1px 2px rgba(15,15,20,0.20);
  }
  .sa .brief-cta:hover { background: var(--ink-2); color: white; }
  .brief-cta svg { width: 13px; height: 13px; stroke-width: 2; }

  /* Activity mini list */
  .act { display: grid; grid-template-columns: 46px 1fr auto; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .act:last-child { border-bottom: none; }
  .act .ts { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--ink-4); font-weight: 500; }
  .act .body .t { font-size: 13.5px; font-weight: 500; display: inline-flex; align-items: baseline; gap: 6px; }
  .act .body .t::before { content: ''; width: 6px; height: 6px; border-radius: 999px; background: var(--good); flex-shrink: 0; transform: translateY(-1px); }
  .act.bad .body .t { color: var(--accent); }
  .act.bad .body .t::before { background: var(--accent); }
  .act.info .body .t::before { background: var(--blue); }
  .act .body .m { font-size: 12px; color: var(--ink-4); margin-top: 3px; padding-left: 12px; }
  .act .ago { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--ink-5); font-weight: 500; }
  .sa .act-more {
    display: flex; align-items: center; justify-content: center; gap: 5px;
    margin-top: 14px; padding: 10px;
    font-size: 12.5px; color: var(--ink-3); font-weight: 500;
    background: var(--surface-2); border-radius: 6px;
    transition: all 150ms var(--ease);
  }
  .sa .act-more:hover { color: var(--ink); background: var(--surface-3); }
  .act-more svg { width: 12px; height: 12px; stroke-width: 2; }

  /* Quick nav */
  .nav-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  @media (max-width: 780px) { .nav-grid { grid-template-columns: 1fr; } }
  .nav-card {
    background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow-md);
    padding: 18px 20px; display: flex; align-items: center; gap: 14px;
    transition: all 200ms var(--ease);
  }
  .nav-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-1px); }
  .nav-card .n-icon {
    width: 34px; height: 34px; border-radius: 7px;
    background: var(--surface-2); color: var(--ink-2);
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: all 150ms var(--ease);
  }
  .nav-card:hover .n-icon { background: var(--ink); color: white; }
  .nav-card .n-icon svg { width: 15px; height: 15px; stroke-width: 2; }
  .nav-card .l { flex: 1; min-width: 0; }
  .nav-card .l .t { font-size: 14px; font-weight: 500; color: var(--ink); }
  .nav-card .l .d { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--ink-4); margin-top: 3px; }
  .nav-card .arr { color: var(--ink-5); transition: color 150ms var(--ease), transform 200ms var(--ease); }
  .nav-card:hover .arr { color: var(--ink); transform: translateX(2px); }
  .nav-card .arr svg { width: 14px; height: 14px; stroke-width: 2; }
</style>

<div class="page-hero">
  <div>
    <div class="eyebrow">Genel Bakış</div>
    <h1>Kontrol Paneli</h1>
    <div class="sub">
      Sistem geneli özet ve dikkat gerektiren işler
      <% if (pendingCounts.total > 0) { %>
        <span class="live">Aksiyon Bekliyor</span>
      <% } %>
    </div>
  </div>
  <div class="actions">
    <a href="/admin/approvals" class="btn btn-primary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      Onaya Git
    </a>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <h2>Sistem Ölçeği <span class="count">gerçek veri</span></h2>
  </div>
  <div class="metrics">
    <div class="m-card">
      <div class="head-row">
        <div class="lbl">Aktif Kurum</div>
        <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M6 18V9a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v9M9 22V12M15 22V12"/></svg></span>
      </div>
      <div class="val"><%= stats.metrics.companies.value %></div>
      <div class="footer">
        <span class="note<%= stats.metrics.companies.delta > 0 ? ' good' : '' %>"><%= stats.metrics.companies.delta > 0 ? '+' + stats.metrics.companies.delta + ' bu ay' : 'bu ay yeni yok' %></span>
      </div>
    </div>
    <div class="m-card">
      <div class="head-row">
        <div class="lbl">Kullanıcı</div>
        <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>
      </div>
      <div class="val"><%= stats.metrics.users.value %></div>
      <div class="footer">
        <span class="note<%= stats.metrics.users.delta > 0 ? ' good' : '' %>"><%= stats.metrics.users.delta > 0 ? '+' + stats.metrics.users.delta + ' bu hafta' : 'bu hafta yeni yok' %></span>
      </div>
    </div>
    <div class="m-card">
      <div class="head-row">
        <div class="lbl">Yüklü Evrak</div>
        <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
      </div>
      <div class="val"><%= stats.metrics.documents.value %></div>
      <div class="footer">
        <span class="note"><%= stats.metrics.documents.delta > 0 ? '+' + stats.metrics.documents.delta + ' bugün' : 'bugün yeni yok' %></span>
      </div>
    </div>
    <div class="m-card">
      <div class="head-row">
        <div class="lbl">Aktif İş Ortaklığı</div>
        <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
      </div>
      <div class="val"><%= stats.metrics.partnerships.value %></div>
      <div class="footer">
        <span class="note<%= stats.metrics.partnerships.delta > 0 ? ' good' : '' %>"><%= stats.metrics.partnerships.delta > 0 ? '+' + stats.metrics.partnerships.delta + ' bu ay' : 'bu ay yeni yok' %></span>
      </div>
    </div>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <h2>Bugün Gündemde <span class="count">3 konu</span></h2>
  </div>
  <div class="prio-grid">
    <a href="/admin/approvals" class="prio-card accent">
      <span class="icn-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
      <div class="top-row">
        <span class="lbl">Onay Bekliyor</span>
        <span class="go-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </div>
      <div class="value"><%= pendingCounts.total %></div>
      <div class="desc">
        <% if (pendingCounts.total === 0) { %>
          tüm onaylar tamamlandı, ekran boş
        <% } else { %>
          iş sırada · en eski işi görüntülemek için <strong>tıkla</strong>
        <% } %>
      </div>
    </a>
    <div class="prio-card good">
      <span class="icn-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 6 23 6 23 12"/><path d="M23 6l-9.5 9.5-5-5L1 18"/></svg></span>
      <div class="top-row">
        <span class="lbl">Bu Ayın Büyümesi</span>
      </div>
      <div class="value"><%= stats.growth.pct >= 0 ? '+' : '' %><%= stats.growth.pct %>%</div>
      <div class="desc">
        yeni kurum · bu ay <strong><%= stats.growth.thisMonth %></strong>, geçen ay <strong><%= stats.growth.lastMonth %></strong>
      </div>
    </div>
    <a href="/admin/audit" class="prio-card blue">
      <span class="icn-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></span>
      <div class="top-row">
        <span class="lbl">Son 24 Saat</span>
        <span class="go-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </div>
      <div class="value"><%= stats.last24h.verified %> <span style="color:var(--ink-4);font-weight:500;">·</span> <%= stats.last24h.rejected %></div>
      <div class="desc">belge onay · ret · denetim izine <strong>git</strong></div>
    </a>
  </div>
</div>

<div class="section">
  <div class="row-split">
    <div class="card">
      <div class="card-head">
        <h3>Bu Ayın Özeti</h3>
        <span class="stamp">bu ay</span>
      </div>
      <div class="brief-lead">
        Sisteme <span class="num"><%= stats.monthly.newCompanies %></span> yeni kurum katıldı ve <span class="num"><%= stats.monthly.newPartnerships %></span> yeni iş birliği kuruldu.
      </div>
      <p class="brief-para">
        Bu ay <span class="num"><%= stats.monthly.newDocuments %></span> yeni evrak yüklendi ve sisteme <span class="num"><%= stats.monthly.newUsers %></span> yeni kullanıcı dahil oldu.
      </p>
      <a href="/admin/audit" class="brief-cta">
        Denetim izlerine git
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="card">
      <div class="card-head">
        <h3>Son Etkinlik</h3>
        <span class="stamp">son <%= stats.recentActivity.length %></span>
      </div>
      <% if (stats.recentActivity.length === 0) { %>
        <div style="padding:24px 0; text-align:center; color:var(--ink-4); font-size:13px;">Henüz kayıtlı etkinlik yok.</div>
      <% } else { %>
        <% stats.recentActivity.forEach(function(a) { %>
          <div class="act <%= a.kind === 'bad' ? 'bad' : (a.kind === 'info' ? 'info' : '') %>">
            <span class="ts"><%= a.time %></span>
            <div class="body"><div class="t"><%= a.title %></div><% if (a.meta) { %><div class="m"><%= a.meta %></div><% } %></div>
            <span class="ago"><%= a.ago %></span>
          </div>
        <% }); %>
      <% } %>
      <a href="/admin/audit" class="act-more">
        Tümünü aç
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <h2>Hızlı Erişim</h2>
  </div>
  <div class="nav-grid">
    <a class="nav-card" href="/admin/approvals">
      <span class="n-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
      <div class="l"><div class="t">Onay Merkezi</div><div class="d"><%= pendingCounts.total %> iş bekliyor</div></div>
      <span class="arr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
    </a>
    <a class="nav-card" href="/admin/approvals?tab=documents">
      <span class="n-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
      <div class="l"><div class="t">Belge Onayları</div><div class="d"><%= pendingCounts.documents %> belge bekliyor</div></div>
      <span class="arr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
    </a>
    <a class="nav-card" href="/admin/approvals?tab=companies">
      <span class="n-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M6 18V9a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v9M9 22V12M15 22V12"/></svg></span>
      <div class="l"><div class="t">Kurum Onayları</div><div class="d"><%= pendingCounts.companies %> kurum bekliyor</div></div>
      <span class="arr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
    </a>
    <a class="nav-card" href="/admin/approvals?tab=driver-updates">
      <span class="n-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2"/></svg></span>
      <div class="l"><div class="t">Şoför Değişiklikleri</div><div class="d"><%= pendingCounts.driverUpdates %> talep</div></div>
      <span class="arr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
    </a>
    <a class="nav-card" href="/admin/approvals?tab=vehicle-updates">
      <span class="n-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V15a1 1 0 0 0 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg></span>
      <div class="l"><div class="t">Araç Değişiklikleri</div><div class="d"><%= pendingCounts.vehicleUpdates %> talep</div></div>
      <span class="arr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
    </a>
    <a class="nav-card" href="/admin/audit">
      <span class="n-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25M21 5.25V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25"/></svg></span>
      <div class="l"><div class="t">Denetim İzleri</div><div class="d">tüm sistem kayıtları</div></div>
      <span class="arr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
    </a>
  </div>
</div>
