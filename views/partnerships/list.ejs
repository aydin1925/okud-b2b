<div class="space-y-6">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h2 class="text-2xl font-bold text-slate-800 tracking-tight">İş Birliklerim</h2>
      <p class="text-sm text-slate-500 mt-0.5"><%= currentCompany.name %> · aktif kurum-kurum iş ortaklıkları</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/partnerships/redeem"
         class="inline-flex items-center gap-1.5 rounded-lg bg-white border border-slate-200 px-3.5 py-2 text-sm font-semibold text-slate-700 hover:border-blue-300 hover:shadow-soft transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
        </svg>
        Kod ile Katıl
      </a>
      <a href="/company/partnerships/invitations/create"
         class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3.5 py-2 text-sm font-semibold text-white hover:bg-blue-500 transition shadow-lg shadow-blue-500/30">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Yeni Davet
      </a>
    </div>
  </div>

  <% if (partnerships.length === 0) { %>
    <div class="bg-white rounded-2xl shadow-soft ring-1 ring-slate-900/5 p-10 text-center">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-400 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-7 w-7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21" />
        </svg>
      </div>
      <p class="text-slate-600 font-medium">Şu an aktif bir iş ortaklığın yok</p>
      <p class="text-sm text-slate-500 mt-1">Karşı kuruma davet üretebilir veya sana iletilen kodu girebilirsin.</p>
    </div>
  <% } else { %>
    <div class="grid md:grid-cols-2 gap-4">
      <% partnerships.forEach(function(p) { %>
        <%
          const cpInitial = (p.counterparty.name || '?').trim()[0].toUpperCase();
          const cpIsProvider = p.counterparty.type === 'provider';
        %>
        <a href="/company/partnerships/<%= p.id %>"
           class="group block bg-white rounded-2xl shadow-soft ring-1 ring-slate-900/5 hover:ring-blue-400/40 hover:shadow-soft-lg transition overflow-hidden">
          <!-- Sol renkli çubuk (üstte thin bant) -->
          <div class="h-1 <%= cpIsProvider ? 'bg-gradient-to-r from-blue-500 to-blue-600' : 'bg-gradient-to-r from-emerald-500 to-emerald-600' %>"></div>

          <div class="p-5">
            <div class="flex items-start gap-3">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl flex-shrink-0 font-bold text-white
                          <%= cpIsProvider ? 'bg-gradient-to-br from-blue-500 to-blue-700' : 'bg-gradient-to-br from-emerald-500 to-emerald-700' %>
                          shadow-lg <%= cpIsProvider ? 'shadow-blue-500/20' : 'shadow-emerald-500/20' %>">
                <%= cpInitial %>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">Karşı Taraf</p>
                <p class="text-base font-bold text-slate-800 truncate"><%= p.counterparty.name %></p>
                <div class="flex items-center gap-2 mt-1.5">
                  <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full <%= cpIsProvider ? 'bg-blue-50 text-blue-700' : 'bg-emerald-50 text-emerald-700' %>">
                    <%= typeLabels[p.counterparty.type] %>
                  </span>
                </div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 text-slate-300 group-hover:text-blue-500 group-hover:translate-x-0.5 transition flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </div>

            <dl class="mt-4 pt-4 border-t border-slate-100 grid grid-cols-2 gap-3 text-xs">
              <div>
                <dt class="text-slate-400 uppercase tracking-wide font-semibold text-[10px]">Senin Rolün</dt>
                <dd class="mt-1 font-semibold text-slate-700"><%= typeLabels[p.myRole] %></dd>
              </div>
              <div>
                <dt class="text-slate-400 uppercase tracking-wide font-semibold text-[10px]">Başlangıç</dt>
                <dd class="mt-1 font-semibold text-slate-700"><%= p.startedAt %></dd>
              </div>
            </dl>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>
