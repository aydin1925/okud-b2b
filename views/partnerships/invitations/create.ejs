<div class="max-w-xl mx-auto space-y-6">

  <a href="/company/partnerships/invitations" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    Davet Listesi
  </a>

  <div class="bg-white rounded-3xl shadow-soft-lg ring-1 ring-slate-900/5 p-5 sm:p-8">
    <div class="mb-8">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-purple-500 to-purple-700 text-white mb-4 shadow-lg shadow-purple-500/25">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21" /></svg>
      </div>
      <p class="text-xs font-bold uppercase tracking-widest text-purple-600 mb-2">Yeni İş Ortaklığı Daveti</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Karşı bir <span class="font-serif italic text-slate-500">kuruma</span> uzan.</h2>
      <p class="text-slate-500 mt-2 text-sm">Karşı kurum bir <strong><%= targetTypeLabel %></strong> olmalı. Kod 24 saat geçerli — karşı kurum yöneticisi kabul ederse ortaklık kurulur.</p>
    </div>

    <!-- Bağlantı gösterimi (biz + karşı) -->
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 mb-8 rounded-2xl bg-slate-50 ring-1 ring-slate-200 p-4">
      <div class="text-center">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-slate-900 text-white text-xs font-bold mb-2">
          <%= (currentCompany.name || '?').trim()[0].toUpperCase() %>
        </div>
        <p class="text-xs font-bold text-slate-900 truncate"><%= currentCompany.name %></p>
        <p class="text-[10px] text-slate-500 uppercase tracking-widest font-semibold mt-0.5"><%= currentCompany.company_type === 'provider' ? 'Sağlayıcı' : 'Alan' %></p>
      </div>
      <div class="text-slate-300">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>
      </div>
      <div class="text-center">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-purple-100 text-purple-600 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        </div>
        <p class="text-xs font-bold text-slate-900">Karşı kurum</p>
        <p class="text-[10px] text-purple-600 uppercase tracking-widest font-semibold mt-0.5"><%= targetTypeLabel %></p>
      </div>
    </div>

    <% if (error) { %>
      <div class="flex items-start gap-3 rounded-2xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 flex-shrink-0 mt-0.5"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 01.67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 11-.671-1.34l.041-.022zM12 9a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/company/partnerships/invitations/create" method="POST" class="space-y-5">
      <div>
        <label for="label" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Etiket <span class="text-slate-400 font-normal normal-case">(opsiyonel)</span></label>
        <input type="text" id="label" name="label" value="<%= formData.label || '' %>" maxlength="200"
               placeholder="örn: Atatürk İlkokulu için"
               class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
      </div>

      <!-- Provider için: bu davete dahil filo seçimi -->
      <% if (currentCompany.company_type === 'provider') { %>
        <div class="pt-3 border-t border-slate-100">
          <div class="mb-3">
            <p class="text-xs font-bold uppercase tracking-widest text-slate-600 mb-1">Bu davete dahil filo</p>
            <p class="text-xs text-slate-500">Karşı kurumun bu ortaklık kapsamında hangi araç/şoförlerine erişeceğini seç. Kabul edildikten sonra da düzenleyebilirsin.</p>
          </div>

          <!-- Araçlar -->
          <div class="rounded-2xl ring-1 ring-slate-200 overflow-hidden mb-3">
            <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
              <p class="text-sm font-bold text-slate-800">Araçlar <span class="text-xs text-slate-400 font-normal">(<%= fleet.vehicles.length %>)</span></p>
              <div class="flex items-center gap-2 text-xs font-semibold">
                <button type="button" data-toggle-all="vehicle_ids" data-mode="all"  class="text-slate-500 hover:text-slate-900 transition">Tümü</button>
                <span class="text-slate-300">·</span>
                <button type="button" data-toggle-all="vehicle_ids" data-mode="none" class="text-slate-500 hover:text-slate-900 transition">Hiçbiri</button>
              </div>
            </div>
            <div class="p-2 max-h-48 overflow-auto">
              <% if (fleet.vehicles.length === 0) { %>
                <p class="text-sm text-slate-400 text-center py-4">Filonda araç yok.</p>
              <% } %>
              <% fleet.vehicles.forEach(function(v) {
                   const checked = selectedVehicleIds.has(v.profile_id);
              %>
                <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-slate-50 cursor-pointer transition <%= v.disabled ? 'opacity-50 cursor-not-allowed' : '' %>">
                  <input type="checkbox" name="vehicle_ids" value="<%= v.profile_id %>"
                         <%= checked ? 'checked' : '' %>
                         <%= v.disabled ? 'disabled' : '' %>
                         class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-500">
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-bold text-slate-900 font-mono truncate"><%= v.name %></p>
                    <p class="text-[11px] text-slate-500 truncate"><%= v.subtext %></p>
                  </div>
                  <% if (v.disabledNote) { %>
                    <span class="text-[9px] font-bold uppercase tracking-widest text-slate-400 flex-shrink-0"><%= v.disabledNote %></span>
                  <% } %>
                </label>
              <% }); %>
            </div>
          </div>

          <!-- Şoförler -->
          <div class="rounded-2xl ring-1 ring-slate-200 overflow-hidden">
            <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
              <p class="text-sm font-bold text-slate-800">Şoförler <span class="text-xs text-slate-400 font-normal">(<%= fleet.drivers.length %>)</span></p>
              <div class="flex items-center gap-2 text-xs font-semibold">
                <button type="button" data-toggle-all="driver_ids" data-mode="all"  class="text-slate-500 hover:text-slate-900 transition">Tümü</button>
                <span class="text-slate-300">·</span>
                <button type="button" data-toggle-all="driver_ids" data-mode="none" class="text-slate-500 hover:text-slate-900 transition">Hiçbiri</button>
              </div>
            </div>
            <div class="p-2 max-h-48 overflow-auto">
              <% if (fleet.drivers.length === 0) { %>
                <p class="text-sm text-slate-400 text-center py-4">Filonda şoför yok.</p>
              <% } %>
              <% fleet.drivers.forEach(function(d) {
                   const checked = selectedDriverIds.has(d.profile_id);
              %>
                <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-slate-50 cursor-pointer transition <%= d.disabled ? 'opacity-50 cursor-not-allowed' : '' %>">
                  <input type="checkbox" name="driver_ids" value="<%= d.profile_id %>"
                         <%= checked ? 'checked' : '' %>
                         <%= d.disabled ? 'disabled' : '' %>
                         class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-500">
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-bold text-slate-900 truncate"><%= d.name %></p>
                    <p class="text-[11px] text-slate-500 truncate"><%= d.subtext %></p>
                  </div>
                  <% if (d.disabledNote) { %>
                    <span class="text-[9px] font-bold uppercase tracking-widest text-slate-400 flex-shrink-0"><%= d.disabledNote %></span>
                  <% } %>
                </label>
              <% }); %>
            </div>
          </div>

          <p class="text-[11px] text-slate-400 mt-2">En az bir araç veya şoför seçmelisin.</p>
        </div>
      <% } %>

      <div class="flex items-center gap-3 pt-3">
        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800 transition shadow-lg shadow-slate-900/25">
          Kod Üret
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </button>
        <a href="/company/partnerships/invitations" class="text-sm text-slate-500 hover:text-slate-900 transition font-medium">Vazgeç</a>
      </div>
    </form>

    <script>
      (function() {
        document.querySelectorAll('[data-toggle-all]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            const name = btn.getAttribute('data-toggle-all');
            const mode = btn.getAttribute('data-mode');
            document.querySelectorAll('input[type="checkbox"][name="' + name + '"]').forEach(function(cb) {
              if (cb.disabled) return;
              cb.checked = (mode === 'all');
            });
          });
        });
      })();
    </script>
  </div>
</div>
