<div class="space-y-24 py-8">

  <!-- HERO -->
  <section class="relative">
    <!-- Decorative background gradient orbs -->
    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-blue-300/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-purple-300/20 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-4xl mx-auto text-center py-8 sm:py-12">
      <div class="inline-flex items-center gap-2 rounded-full bg-slate-100/80 backdrop-blur ring-1 ring-slate-200 px-4 py-1.5 mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-xs font-semibold text-slate-700">v0.1 — MVP yayında</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-7xl font-bold text-slate-900 tracking-tighter leading-[1.05]">
        Belge yönetimi<br>
        <span class="font-serif italic text-slate-600">artık dert değil.</span>
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-slate-600 mt-4 sm:mt-6 max-w-2xl mx-auto leading-relaxed">
        Şoför, araç sahibi, kurum yöneticisi — herkes tek platformda buluşuyor.
        Belge süreleri otomatik takip ediliyor, sızma sıfır.
      </p>

      <div class="mt-10 flex items-center justify-center gap-3 flex-wrap">
        <% if (currentUser) { %>
          <a href="/dashboard" class="group inline-flex items-center gap-2 rounded-xl bg-slate-900 px-6 py-3.5 text-sm font-bold text-white hover:bg-slate-800 transition shadow-xl shadow-slate-900/25">
            Dashboard'a git
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 group-hover:translate-x-0.5 transition">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        <% } else { %>
          <a href="/register" class="group inline-flex items-center gap-2 rounded-xl bg-slate-900 px-6 py-3.5 text-sm font-bold text-white hover:bg-slate-800 transition shadow-xl shadow-slate-900/25">
            Ücretsiz başla
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 group-hover:translate-x-0.5 transition">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="/login" class="inline-flex items-center gap-2 rounded-xl bg-white ring-1 ring-slate-200 hover:ring-slate-300 px-6 py-3.5 text-sm font-bold text-slate-900 transition">
            Giriş yap
          </a>
        <% } %>
      </div>

      <div class="mt-10 sm:mt-16 grid grid-cols-3 gap-4 sm:gap-8 max-w-2xl mx-auto text-left">
        <div>
          <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">100%</div>
          <div class="text-xs text-slate-500 mt-1 font-medium uppercase tracking-widest">Otonom denetim</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">24<span class="text-slate-400 text-xl">/7</span></div>
          <div class="text-xs text-slate-500 mt-1 font-medium uppercase tracking-widest">Erken uyarı</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">0<span class="text-slate-400 text-xl">₺</span></div>
          <div class="text-xs text-slate-500 mt-1 font-medium uppercase tracking-widest">Başlangıç</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE BENTO -->
  <section>
    <div class="text-center mb-10">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 mb-3">Nasıl çalışır</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        Karmaşık iş, <span class="font-serif italic text-slate-500">basit çözüm</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-4">

      <!-- Kart 1: Kayıt -->
      <div class="group relative overflow-hidden rounded-3xl bg-white ring-1 ring-slate-900/5 shadow-soft hover:shadow-soft-xl transition p-6 sm:p-8">
        <div class="absolute -top-8 -right-8 w-40 h-40 bg-emerald-100 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition"></div>
        <div class="relative">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-700 text-white shadow-lg shadow-emerald-500/30 mb-5">
            <span class="text-lg font-black">1</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Belgeni yükle</h3>
          <p class="text-slate-500 mt-2 text-sm leading-relaxed">Ehliyet, SRC, ruhsat, sigorta — hepsi tek yerde. Fotoğraf çek veya PDF ekle, yeter.</p>
        </div>
      </div>

      <!-- Kart 2: Onay -->
      <div class="group relative overflow-hidden rounded-3xl bg-white ring-1 ring-slate-900/5 shadow-soft hover:shadow-soft-xl transition p-6 sm:p-8">
        <div class="absolute -top-8 -right-8 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition"></div>
        <div class="relative">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-blue-700 text-white shadow-lg shadow-blue-500/30 mb-5">
            <span class="text-lg font-black">2</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Kuruma katıl</h3>
          <p class="text-slate-500 mt-2 text-sm leading-relaxed">Kurum sana OTP kodu iletir. Kodu girer, KVKK onayını verir, sözleşmeyi imzalarsın. Bittin.</p>
        </div>
      </div>

      <!-- Kart 3: Otomatik takip -->
      <div class="group relative overflow-hidden rounded-3xl bg-white ring-1 ring-slate-900/5 shadow-soft hover:shadow-soft-xl transition p-6 sm:p-8">
        <div class="absolute -top-8 -right-8 w-40 h-40 bg-amber-100 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition"></div>
        <div class="relative">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 text-white shadow-lg shadow-amber-500/30 mb-5">
            <span class="text-lg font-black">3</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Bildirim al</h3>
          <p class="text-slate-500 mt-2 text-sm leading-relaxed">Belge süresi dolmak üzereyken sistem seni önceden uyarır. Kimsenin yola çıkmadan yenile.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROLES SPOTLIGHT -->
  <section>
    <div class="grid lg:grid-cols-2 gap-4">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 sm:p-10 shadow-2xl ring-1 ring-slate-900/10">
        <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/20 rounded-full blur-3xl"></div>
        <div class="relative">
          <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-300 mb-3">Şoför / Araç Sahibi</p>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-tight">
            Tek profil,<br>
            <span class="font-serif italic text-emerald-200">sınırsız kurum.</span>
          </h3>
          <p class="text-slate-300 mt-4 leading-relaxed">Belgelerini bir kere yükle, birden fazla kurumun filosuna kod ile katıl.</p>
          <ul class="mt-6 space-y-2.5 text-sm text-slate-300">
            <li class="flex items-center gap-2">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-300">✓</span>
              KVKK korumalı veri paylaşımı
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-300">✓</span>
              Süre dolmadan bildirim + e-posta
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-300">✓</span>
              Sözleşme snapshot'ı kalıcı arşiv
            </li>
          </ul>
        </div>
      </div>

      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-900 p-6 sm:p-10 shadow-2xl ring-1 ring-slate-900/10">
        <div class="absolute top-0 left-0 w-64 h-64 bg-purple-400/20 rounded-full blur-3xl"></div>
        <div class="relative">
          <p class="text-[10px] font-bold uppercase tracking-widest text-blue-200 mb-3">Kurum / Kooperatif / Okul</p>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-tight">
            Filoyu yönet,<br>
            <span class="font-serif italic text-blue-200">operasyon aksamasın.</span>
          </h3>
          <p class="text-blue-100/90 mt-4 leading-relaxed">Şoför, araç, iş ortaklığı — hepsi tek panelde. Kırmızı liste, yeşil liste, hep önünde.</p>
          <ul class="mt-6 space-y-2.5 text-sm text-blue-100">
            <li class="flex items-center gap-2">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-white">✓</span>
              OTP kod ile hızlı davet
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-white">✓</span>
              Kurumsal sözleşme şablonu editörü
            </li>
            <li class="flex items-center gap-2">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-white">✓</span>
              Kurum-kurum iş ortaklığı yönetimi
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="text-center pt-4">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
        <span class="font-serif italic text-slate-500">30 saniyede</span> başla.
      </h2>
      <p class="text-slate-500 mt-3">Hesap ücretsiz, mecburi ödeme yok. Yeter ki belgen düzgün olsun.</p>
      <div class="mt-8 flex items-center justify-center gap-3">
        <% if (currentUser) { %>
          <a href="/dashboard" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-6 py-3.5 text-sm font-bold text-white hover:bg-slate-800 transition shadow-xl shadow-slate-900/25">
            Dashboard'a git →
          </a>
        <% } else { %>
          <a href="/register" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-6 py-3.5 text-sm font-bold text-white hover:bg-slate-800 transition shadow-xl shadow-slate-900/25">
            Hesap oluştur →
          </a>
        <% } %>
      </div>
    </div>
  </section>

</div>
