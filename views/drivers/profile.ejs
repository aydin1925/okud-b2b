<% if (!profile) { %>
  <!-- Profil yok — hero CTA -->
  <div class="max-w-2xl mx-auto">
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 shadow-2xl ring-1 ring-slate-900/10 p-12">
      <div class="absolute -top-32 -right-32 w-96 h-96 bg-emerald-500/25 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-blue-500/15 rounded-full blur-3xl"></div>
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.7) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.7) 1px, transparent 1px); background-size: 40px 40px;"></div>

      <div class="relative text-center">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-600 text-white shadow-xl shadow-emerald-500/40 ring-1 ring-white/20 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-8 w-8"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        </div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-300 mb-2">Şoför Profili</p>
        <h1 class="text-white text-3xl sm:text-4xl font-bold tracking-tighter leading-tight">
          Şoför olmaya<br>
          <span class="font-serif italic text-emerald-200">hazır mısın?</span>
        </h1>
        <p class="text-slate-300 mt-4 max-w-md mx-auto">Kimlik bilgilerini kaydet, ehliyet ve SRC belgelerini yükle. Kurumlar seni davet etmeye başlasın.</p>
        <a href="/driver/profile/create"
           class="inline-flex items-center gap-2 mt-8 rounded-xl bg-white text-slate-900 px-6 py-3 text-sm font-bold hover:bg-slate-100 transition shadow-xl">
          Profili Oluştur
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </div>
  </div>
<% } else { %>
  <%
    const stMap = {
      pending_docs: { label: 'Belge bekleniyor', text: 'text-amber-300',   dot: 'bg-amber-400',   ring: 'ring-amber-400/40',   bg: 'bg-amber-500/10' },
      active:       { label: 'Aktif',            text: 'text-emerald-300', dot: 'bg-emerald-400', ring: 'ring-emerald-400/40', bg: 'bg-emerald-500/10' },
      inactive:     { label: 'Pasif',            text: 'text-slate-300',   dot: 'bg-slate-400',   ring: 'ring-slate-400/40',   bg: 'bg-slate-500/10' },
    };
    const st = stMap[profile.status] || stMap.inactive;
    const initials = (currentUser.name || '?').trim().split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();
    // Belge özeti — kaç tanesi onaylı
    const docs = documents || [];
    const uniqueTypes = new Set(docs.filter(d => d.verification_status === 'verified').map(d => d.document_type));
    const verifiedCount = uniqueTypes.size;
    const totalRequired = requiredTypes.length;
  %>

  <div class="space-y-6">

    <!-- HERO -->
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 shadow-2xl ring-1 ring-slate-900/10">
      <div class="absolute -top-32 -right-32 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-blue-500/15 rounded-full blur-3xl"></div>
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.7) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.7) 1px, transparent 1px); background-size: 40px 40px;"></div>

      <div class="relative p-8">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex items-start gap-4">
            <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-600 text-white text-xl font-black shadow-xl shadow-emerald-500/30 ring-1 ring-white/20 flex-shrink-0">
              <%= initials %>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-300 mb-1">Şoför Profili</p>
              <h1 class="text-white text-3xl sm:text-4xl font-bold tracking-tighter"><%= currentUser.name %></h1>
              <p class="text-slate-300 mt-1.5"><span class="font-serif italic text-slate-400"><%= profile.license_class %></span> sınıfı ehliyet</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div class="inline-flex items-center gap-2 rounded-full <%= st.bg %> backdrop-blur ring-1 <%= st.ring %> px-4 py-1.5">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full <%= st.dot %> opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 <%= st.dot %>"></span>
              </span>
              <span class="text-xs font-bold <%= st.text %> uppercase tracking-widest"><%= st.label %></span>
            </div>
            <a href="/driver/profile/edit" class="inline-flex items-center gap-1.5 rounded-full bg-white/10 backdrop-blur ring-1 ring-white/20 px-3 py-1.5 text-xs font-bold text-white hover:bg-white/20 transition">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" /></svg>
              Düzenle
            </a>
          </div>
        </div>

        <% if (pendingRequest) { %>
          <div class="mt-6 rounded-2xl bg-amber-500/10 backdrop-blur ring-1 ring-amber-400/30 px-4 py-3 flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-amber-300 flex-shrink-0 mt-0.5"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm.75-5.25a.75.75 0 000 1.5h.75v9.75a.75.75 0 001.5 0V8.25h.75a.75.75 0 000-1.5H3z" clip-rule="evenodd" /></svg>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-bold text-amber-200">Bekleyen değişiklik talebin var</p>
              <p class="text-xs text-amber-100/80 mt-0.5">SuperAdmin inceleyip karar verecek. Sonucu profilde görürsün.</p>
            </div>
            <form action="/driver/profile/updates/<%= pendingRequest.id %>/cancel" method="POST"
                  data-confirm="Bekleyen değişiklik talebini iptal etmek üzeresin."
                  data-confirm-button="Evet, iptal et" data-confirm-danger>
              <button type="submit" class="rounded-lg bg-white/10 hover:bg-white/20 text-white px-3 py-1 text-xs font-semibold transition">
                İptal Et
              </button>
            </form>
          </div>
        <% } %>

        <!-- Belge özeti bar -->
        <div class="mt-6">
          <div class="flex items-center justify-between mb-2">
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Belge Durumu</p>
            <p class="text-xs text-slate-300 font-semibold"><span class="text-white"><%= verifiedCount %></span>/<%= totalRequired %> onaylı</p>
          </div>
          <div class="h-2 rounded-full bg-white/5 overflow-hidden">
            <div class="h-full bg-gradient-to-r from-emerald-400 to-emerald-500 transition-all" style="width: <%= totalRequired > 0 ? (verifiedCount / totalRequired) * 100 : 0 %>%"></div>
          </div>
        </div>

        <!-- Alt: metrikler -->
        <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-2">
          <div class="rounded-xl bg-white/5 backdrop-blur ring-1 ring-white/10 p-3">
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">TC</p>
            <p class="text-white font-semibold text-sm mt-1 font-mono"><%= profile.national_id %></p>
          </div>
          <div class="rounded-xl bg-white/5 backdrop-blur ring-1 ring-white/10 p-3">
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Telefon</p>
            <p class="text-white font-semibold text-sm mt-1"><%= profile.phone %></p>
          </div>
          <div class="rounded-xl bg-white/5 backdrop-blur ring-1 ring-white/10 p-3">
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Doğum</p>
            <p class="text-white font-semibold text-sm mt-1"><%= profile.birth_date %></p>
          </div>
          <div class="rounded-xl bg-white/5 backdrop-blur ring-1 ring-white/10 p-3">
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Sınıf</p>
            <p class="text-white font-semibold text-sm mt-1"><%= profile.license_class %></p>
          </div>
        </div>

        <% if (profile.notes) { %>
          <div class="mt-4 rounded-2xl bg-white/5 backdrop-blur ring-1 ring-white/10 px-4 py-3">
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Not</p>
            <p class="text-sm text-slate-200"><%= profile.notes %></p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Belgeler grid -->
    <div>
      <div class="flex items-center gap-2 mb-4">
        <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-900 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900">Belgelerim</h3>
      </div>
      <div class="grid md:grid-cols-2 gap-3">
        <% requiredTypes.forEach(function(type) { %>
          <% const doc = documentsByType[type];
             let barColor = 'from-red-400 to-red-600', stLabel = 'Yüklenmedi', stBg = 'bg-red-50 text-red-700', stDot = 'bg-red-500';
             if (doc) {
               if (doc.verification_status === 'pending')  { barColor = 'from-amber-400 to-amber-600'; stLabel = 'Onay bekliyor'; stBg = 'bg-amber-50 text-amber-700'; stDot = 'bg-amber-500'; }
               if (doc.verification_status === 'verified') { barColor = 'from-emerald-400 to-emerald-600'; stLabel = 'Onaylandı'; stBg = 'bg-emerald-50 text-emerald-700'; stDot = 'bg-emerald-500'; }
               if (doc.verification_status === 'rejected') { barColor = 'from-red-400 to-red-600'; stLabel = 'Reddedildi'; stBg = 'bg-red-50 text-red-700'; stDot = 'bg-red-500'; }
             }
          %>
          <div class="relative overflow-hidden bg-white rounded-2xl shadow-soft ring-1 ring-slate-900/5 p-5">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b <%= barColor %>"></div>
            <div class="pl-4">
              <div class="flex items-start justify-between gap-3 mb-3">
                <p class="font-bold text-slate-900"><%= typeLabels[type] %></p>
                <span class="inline-flex items-center gap-1 rounded-full <%= stBg %> px-2.5 py-0.5 text-[11px] font-bold">
                  <span class="h-1.5 w-1.5 rounded-full <%= stDot %>"></span>
                  <%= stLabel %>
                </span>
              </div>
              <% if (doc) { %>
                <div class="grid grid-cols-2 gap-2 text-xs">
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Yükleme</p>
                    <p class="text-slate-700 font-semibold mt-0.5"><%= doc.created_at %></p>
                  </div>
                  <% if (doc.expires_at) { %>
                    <div>
                      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Son Geç.</p>
                      <p class="text-slate-700 font-semibold mt-0.5"><%= doc.expires_at %></p>
                    </div>
                  <% } %>
                </div>
                <% if (doc.rejection_reason) { %>
                  <p class="mt-2 text-xs text-red-700 rounded-md bg-red-50 px-2 py-1"><em>Gerekçe:</em> <%= doc.rejection_reason %></p>
                <% } %>
              <% } else { %>
                <p class="text-xs text-slate-500">Bu belgeyi henüz yüklemedin</p>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Yükleme -->
    <div class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-6">
      <div class="flex items-center gap-3 mb-5">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-700 text-white shadow-lg shadow-emerald-500/25">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" /></svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">Belge Yükle</h3>
          <p class="text-xs text-slate-500">JPG, PNG, WEBP veya PDF · Max 5 MB</p>
        </div>
      </div>

      <form action="/driver/documents/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="document_type" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Belge Türü</label>
            <select id="document_type" name="document_type" required
                    class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
              <option value="">Seçiniz</option>
              <% requiredTypes.forEach(function(type) { %>
                <option value="<%= type %>"><%= typeLabels[type] %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label for="expires_at" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Son Geçerlilik <span class="text-slate-400 font-normal normal-case">(opsiyonel)</span></label>
            <input type="date" id="expires_at" name="expires_at"
                   class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
          </div>
        </div>
        <div>
          <label for="file" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Dosya</label>
          <input type="file" id="file" name="file" accept=".jpg,.jpeg,.png,.webp,.pdf" required
                 class="w-full text-sm text-slate-600 file:mr-3 file:rounded-xl file:border-0 file:bg-slate-900 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-white hover:file:bg-slate-800 file:transition file:cursor-pointer">
        </div>
        <button type="submit"
                class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800 transition shadow-lg shadow-slate-900/25">
          Yükle
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" /></svg>
        </button>
      </form>
    </div>

  </div>
<% } %>
