<%
  const company = rel.company;
  const initial = (company.name || '?').trim()[0].toUpperCase();

  function fmtDate(d) {
    if (!d) return '';
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return '';
    return dt.toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }
  function fmtDateLong(d) {
    if (!d) return '';
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return '';
    return dt.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
  }
  function fmtDateTime(d) {
    if (!d) return '';
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return '';
    return dt.toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric' })
         + ', ' + dt.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
  }
  function durationSince(d) {
    if (!d) return '—';
    const start = new Date(d);
    if (isNaN(start.getTime())) return '—';
    const now = new Date();
    let years = now.getFullYear() - start.getFullYear();
    let months = now.getMonth() - start.getMonth();
    let days = now.getDate() - start.getDate();
    if (days < 0) { months--; days += 30; }
    if (months < 0) { years--; months += 12; }
    const parts = [];
    if (years)  parts.push(years + ' yıl');
    if (months) parts.push(months + ' ay');
    if (!years && days) parts.push(days + ' gün');
    if (!parts.length) return 'Bugün';
    return parts.join(' ');
  }
  function plateParts(p) {
    if (!p) return '';
    const clean = String(p).trim().toUpperCase().replace(/\s+/g, '');
    const m = clean.match(/^(\d{1,2})([A-ZÇĞİÖŞÜ]+)(\d+)$/);
    if (m) return `${m[1]} ${m[2]} ${m[3]}`;
    return String(p).trim().toUpperCase();
  }
  function initialsOf(name) {
    if (!name) return '?';
    return name.trim().split(/\s+/).map(w => w[0]).slice(0,2).join('').toUpperCase();
  }
  const companyTypeLabel = company.company_type === 'provider' ? 'Hizmet Sağlayıcı' : (company.company_type === 'receiver' ? 'Hizmet Alan' : 'Kurum');
  const stats = rel.documentStats;
%>

<div class="user-view">
  <div class="rel-view">

    <!-- Geri dön kırıntısı -->
    <div class="rel-crumb">
      <a href="/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </a>
      <a href="/dashboard">Kurumların</a>
      <span class="sep">/</span>
      <span class="cur"><%= company.name %></span>
    </div>

    <!-- HERO -->
    <div class="rel-hero">
      <div class="rel-hero-top">
        <div class="logo"><%= initial %></div>
        <div style="flex:1; min-width:0;">
          <div class="name"><%= company.name %></div>
          <div class="tags">
            <span class="tag type">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M6 18V9a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v9M9 22V12M15 22V12"/></svg>
              <%= companyTypeLabel %>
            </span>
            <% if (company.is_active) { %>
              <span class="tag active">
                <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                Aktif
              </span>
            <% } else { %>
              <span class="tag pending">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                Onay bekliyor
              </span>
            <% } %>
          </div>
        </div>
      </div>

      <div class="rel-hero-stats">
        <div class="rel-stat">
          <div class="lab">Bağlantı süresi</div>
          <div class="val"><%= durationSince(rel.earliestConnectedAt) %></div>
          <div class="sub"><%= fmtDateLong(rel.earliestConnectedAt) %>'dan beri</div>
        </div>
        <div class="rel-stat">
          <div class="lab">Rolün</div>
          <% if (rel.roles.length === 0) { %>
            <div class="sub">—</div>
          <% } else { %>
            <div class="roles">
              <% rel.roles.forEach(function(r) { %>
                <span class="role">
                  <% if (r.key === 'driver') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>
                  <% } else if (r.key === 'vehicle') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l2-6h14l2 6M5 13v5h14v-5M7 13V9M17 13V9"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/></svg>
                  <% } else { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                  <% } %>
                  <%= r.label %>
                </span>
              <% }); %>
            </div>
          <% } %>
        </div>
        <div class="rel-stat">
          <div class="lab">Katılım kodu</div>
          <% if (rel.inviteCode) { %>
            <div class="val mono"><%= rel.inviteCode %></div>
            <div class="sub"><%= fmtDateTime(rel.earliestConnectedAt) %></div>
          <% } else { %>
            <div class="sub">—</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- İKİ SÜTUN: Araçlar + Hostesler (varsa) -->
    <% if (rel.vehicles.length > 0 || rel.hostesses.length > 0) { %>
    <div class="rel-grid-2">

      <% if (rel.vehicles.length > 0) { %>
      <div class="rel-card">
        <div class="rel-card-head">
          <div class="rel-card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l2-6h14l2 6M5 13v5h14v-5M7 13V9M17 13V9"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/></svg>
            Bu kuruma bağlı araçların
          </div>
          <span class="rel-count-pill"><%= rel.vehicles.length %> araç</span>
        </div>

        <% rel.vehicles.forEach(function(v) { %>
          <div class="rel-vehicle-row">
            <div class="plate">
              <div class="tr">TR</div>
              <div class="num"><%= plateParts(v.plate_number) %></div>
            </div>
            <div class="info">
              <div class="n"><%= [v.brand, v.model].filter(Boolean).join(' ') || 'Araç' %></div>
              <div class="m">
                <% if (v.capacity) { %><%= v.capacity %>+1<% } %>
                <% if (v.year) { %><% if (v.capacity) { %> · <% } %><%= v.year %><% } %>
              </div>
            </div>
            <div class="date">
              <span>Bağlantı</span>
              <b><%= fmtDate(v.connected_at) %></b>
            </div>
          </div>
        <% }); %>
      </div>
      <% } %>

      <% if (rel.hostesses.length > 0) { %>
      <div class="rel-card">
        <div class="rel-card-head">
          <div class="rel-card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
            Bağlı hostesin
          </div>
          <span class="rel-count-pill"><%= rel.hostesses.length %></span>
        </div>

        <% rel.hostesses.forEach(function(h) { %>
          <% const fullName = [h.hostess_first_name, h.hostess_last_name].filter(Boolean).join(' '); %>
          <div class="rel-person-row">
            <div class="av"><%= initialsOf(fullName) %></div>
            <div class="info">
              <div class="n"><%= fullName || 'Hostes' %></div>
              <div class="m"><%= fmtDate(h.connected_at) %>'dan beri</div>
            </div>
          </div>
        <% }); %>
      </div>
      <% } %>

    </div>
    <% } %>

    <!-- BELGELER -->
    <div class="rel-card" style="margin-bottom: 16px;">
      <div class="rel-card-head">
        <div class="rel-card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 15l2 2 4-4"/></svg>
          Kurumun gördüğü belgeler
        </div>
        <span class="rel-count-pill"><%= stats.total %> belge</span>
      </div>
      <div class="rel-card-desc"><%= company.name %> bu belgelere erişebilir. Diğer belgelerin görünmez.</div>

      <% if (stats.total > 0) { %>
        <div class="rel-doc-stats">
          <div class="rel-doc-stat ok" style="flex: <%= Math.max(1, stats.approved) %>;">
            <div class="l">Onaylı</div>
            <div class="v"><%= stats.approved %></div>
          </div>
          <div class="rel-doc-stat wt" style="flex: <%= Math.max(1, stats.pending) %>;">
            <div class="l">Beklemede</div>
            <div class="v"><%= stats.pending %></div>
          </div>
          <div class="rel-doc-stat rj" style="flex: <%= Math.max(1, stats.rejected) %>;">
            <div class="l">Reddedildi</div>
            <div class="v"><%= stats.rejected %></div>
          </div>
        </div>

        <% rel.documents.forEach(function(d) {
             const isRj = d.verification_status === 'rejected';
             const isOk = d.verification_status === 'verified';
             const cls = isRj ? 'rj' : (isOk ? 'ok' : 'wt');
             const badge = isRj ? 'Reddedildi' : (isOk ? 'Onaylı' : 'Beklemede');
        %>
          <div class="rel-doc-row <%= isRj ? 'is-rj' : '' %>">
            <span class="icn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </span>
            <div class="info">
              <div class="t"><%= d.type_label %> <% if (d.owner_kind === 'vehicle') { %>— <%= d.owner_label %><% } %></div>
              <div class="m">
                <% if (d.owner_kind === 'driver')  { %>Şoför<% } %>
                <% if (d.owner_kind === 'vehicle') { %>Araç<% } %>
                <% if (d.owner_kind === 'hostess') { %>Hostes · <%= d.owner_label %><% } %>
                <% if (d.expires_at) { %> · Geçerli: <%= fmtDate(d.expires_at) %><% } %>
                <% if (isRj && d.rejection_reason) { %> · "<%= d.rejection_reason %>"<% } %>
              </div>
            </div>
            <span class="badge <%= cls %>"><%= badge %></span>
          </div>
        <% }); %>
      <% } else { %>
        <div class="rel-doc-empty">Bu kurumla paylaşılacak belge henüz yok.</div>
      <% } %>
    </div>

    <!-- İLETİŞİM + SON ETKİNLİK -->
    <div class="rel-grid-2" style="grid-template-columns: 1fr 1fr;">
      <div class="rel-card">
        <div class="rel-card-head" style="margin-bottom: 12px;">
          <div class="rel-card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5a2 2 0 0 1 2-2h2l2 4-2 2a11 11 0 0 0 6 6l2-2 4 2v2a2 2 0 0 1-2 2A18 18 0 0 1 3 5z"/></svg>
            Kurum yetkilisi
          </div>
        </div>
        <% if (rel.primaryContact) { %>
          <% const fn = rel.primaryContact.first_name || ''; %>
          <% const ln = rel.primaryContact.last_name  || ''; %>
          <% const fullName = (fn + ' ' + ln).trim(); %>
          <div class="rel-contact-row">
            <div class="av"><%= initialsOf(fullName) %></div>
            <div class="info">
              <div class="n"><%= fullName || 'Kurum yöneticisi' %></div>
              <div class="m"><%= rel.primaryContact.email %></div>
            </div>
          </div>
          <div class="rel-contact-actions">
            <a class="a-mail" href="mailto:<%= rel.primaryContact.email %>">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
              E-posta
            </a>
          </div>
        <% } else { %>
          <div class="rel-contact-empty">Kurum yöneticisi bilgisi bulunamadı.</div>
        <% } %>
      </div>

      <div class="rel-card">
        <div class="rel-card-head" style="margin-bottom: 12px;">
          <div class="rel-card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            Son etkinlik
          </div>
        </div>
        <% if (rel.recentActivity.length === 0) { %>
          <div class="rel-tl-empty">Henüz kurum tarafında bir işlem yok.</div>
        <% } else { %>
          <div class="rel-timeline">
            <% rel.recentActivity.forEach(function(a) {
                 const cls = a.kind === 'verified' ? 'ok' : (a.kind === 'rejected' ? 'rj' : 'wt');
                 const verb = a.kind === 'verified' ? 'onaylandı' : (a.kind === 'rejected' ? 'reddedildi' : 'işlendi');
            %>
              <div class="rel-tl-row">
                <div class="rel-tl-dot <%= cls %>"></div>
                <div class="info">
                  <div class="t"><b><%= a.title %></b> <%= verb %><% if (a.owner && a.owner !== 'Şoför belgesi') { %> · <%= a.owner %><% } %></div>
                  <div class="m"><%= fmtDate(a.at) %><% if (a.reason) { %> · "<%= a.reason %>"<% } %></div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Tehlikeli alan — şimdilik pasif -->
    <div class="rel-danger">
      <div>
        <div class="t">Bağlantıyı sonlandır</div>
        <div class="m">Bu kurumun filosundaki tüm bağlantıların pasif olur. Belgen kurumdan gizlenir.</div>
      </div>
      <button type="button" disabled title="Yakında" style="opacity: 0.55; cursor: not-allowed;">Yakında</button>
    </div>

  </div>
</div>
