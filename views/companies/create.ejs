<div class="max-w-xl mx-auto space-y-6">

  <a href="/dashboard" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
    Dashboard
  </a>

  <div class="bg-white rounded-3xl shadow-soft-lg ring-1 ring-slate-900/5 p-5 sm:p-8">
    <div class="mb-8">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-slate-900 to-slate-700 text-white mb-4 shadow-lg shadow-slate-900/20">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
        </svg>
      </div>
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 mb-2">Yeni Kurum</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Bir kurum kur, <span class="font-serif italic text-slate-500">başlat.</span></h2>
      <p class="text-slate-500 mt-2 text-sm">Okul veya kooperatif için yeni bir çalışma alanı oluştur. SuperAdmin onayından sonra aktif olur.</p>
    </div>

    <% if (error) { %>
      <div class="flex items-start gap-3 rounded-2xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 flex-shrink-0 mt-0.5">
          <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 01.67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 11-.671-1.34l.041-.022zM12 9a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
        </svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/companies/create" method="POST" class="space-y-5">
      <div>
        <label for="name" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Kurum Adı</label>
        <input type="text" id="name" name="name" value="<%= formData.name || '' %>" required
               placeholder="Aydın Lojistik A.Ş."
               class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
      </div>

      <div>
        <label for="tax_number" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Vergi Numarası</label>
        <input type="text" id="tax_number" name="tax_number" value="<%= formData.tax_number || '' %>" required
               placeholder="1234567890"
               class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-slate-900 focus:outline-none transition font-mono tracking-wider">
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Kurum Tipi</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="relative cursor-pointer">
            <input type="radio" name="company_type" value="provider" <%= formData.company_type === 'provider' ? 'checked' : '' %> class="peer sr-only" required>
            <div class="rounded-2xl ring-1 ring-slate-200 bg-white p-4 hover:ring-slate-300 peer-checked:ring-2 peer-checked:ring-slate-900 peer-checked:bg-slate-50 transition">
              <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100 text-blue-600 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                </svg>
              </div>
              <p class="font-bold text-slate-900 text-sm">Hizmet Sağlayıcı</p>
              <p class="text-xs text-slate-500 mt-0.5">Kooperatif, taşeron</p>
            </div>
          </label>
          <label class="relative cursor-pointer">
            <input type="radio" name="company_type" value="receiver" <%= formData.company_type === 'receiver' ? 'checked' : '' %> class="peer sr-only" required>
            <div class="rounded-2xl ring-1 ring-slate-200 bg-white p-4 hover:ring-slate-300 peer-checked:ring-2 peer-checked:ring-slate-900 peer-checked:bg-slate-50 transition">
              <div class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600 mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
                </svg>
              </div>
              <p class="font-bold text-slate-900 text-sm">Hizmet Alan</p>
              <p class="text-xs text-slate-500 mt-0.5">Okul, firma</p>
            </div>
          </label>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-3">
        <button type="submit"
                class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800 transition shadow-lg shadow-slate-900/25">
          Kurumu Oluştur
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </button>
        <a href="/dashboard" class="text-sm text-slate-500 hover:text-slate-900 transition font-medium">Vazgeç</a>
      </div>
    </form>

    <div class="mt-8 pt-6 border-t border-slate-100 flex items-start gap-2 text-xs text-slate-500">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-slate-300 flex-shrink-0 mt-0.5">
        <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
      </svg>
      Kurum oluşturulduktan sonra SuperAdmin onayı bekleyecek. Aktif olduğunda filo yönetim araçlarına erişim açılır.
    </div>
  </div>
</div>
