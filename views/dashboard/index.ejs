<%
  const initials = (currentUser.name || '?').trim().split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();
  const isManager = currentCompany && (currentCompany.role.name === 'company_admin' || currentCompany.role.name === 'company_moderator');
  const isAdmin   = currentCompany && currentCompany.role.name === 'company_admin';
  const hour = new Date().getHours();
  const greeting = hour < 6 ? 'İyi geceler' : hour < 12 ? 'Günaydın' : hour < 18 ? 'İyi günler' : 'İyi akşamlar';
  const firstName = currentUser.name.split(' ')[0];
%>

<div class="space-y-8">

  <!-- Hero Greeting -->
  <div class="flex items-start justify-between flex-wrap gap-4">
    <div>
      <p class="text-sm font-medium text-slate-500 mb-1"><%= greeting %>, hoş geldin</p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 tracking-tight">
        <%= firstName %>. <span class="font-serif italic text-slate-500">Bugün</span> ne yapmak istersin?
      </h1>
    </div>
    <div class="inline-flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-slate-900 to-slate-700 text-white text-base font-bold shadow-xl shadow-slate-900/20 ring-1 ring-white/10">
      <%= initials %>
    </div>
  </div>

  <!-- Aktif çalışma alanı (bento) -->
  <% if (currentCompany) { %>
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 sm:p-8 shadow-2xl ring-1 ring-slate-900/10">
      <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-purple-500/10 rounded-full blur-3xl"></div>

      <div class="relative">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-blue-300 mb-2">Aktif Çalışma Alanı</p>
            <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight break-words"><%= currentCompany.name %></h2>
            <div class="flex items-center gap-2 mt-3 flex-wrap">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 backdrop-blur px-3 py-1 text-xs font-semibold text-white ring-1 ring-white/20">
                <%= currentCompany.role.display_name %>
              </span>
              <% if (currentCompany.is_active) { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-400/20 backdrop-blur px-3 py-1 text-xs font-semibold text-emerald-300 ring-1 ring-emerald-400/30">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                  Onaylı kurum
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-400/20 backdrop-blur px-3 py-1 text-xs font-semibold text-amber-300 ring-1 ring-amber-400/30">
                  SuperAdmin onayı bekliyor
                </span>
              <% } %>
            </div>
          </div>
          <form action="/companies/clear" method="POST">
            <button type="submit" class="rounded-xl bg-white/10 backdrop-blur text-white/80 hover:text-white hover:bg-white/20 px-3 py-1.5 text-xs font-medium ring-1 ring-white/20 transition">
              Alandan çık
            </button>
          </form>
        </div>

        <% if (isManager) { %>
          <div class="mt-8 pt-8 border-t border-white/10">
            <p class="text-[10px] font-bold uppercase tracking-widest text-blue-200 mb-4">Yönetim Araçları</p>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">

              <a href="/company/fleet/drivers" class="group rounded-xl bg-white/5 hover:bg-white/10 backdrop-blur ring-1 ring-white/10 hover:ring-white/25 px-3 py-4 transition text-center">
                <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-400/20 text-blue-300 mb-2 group-hover:scale-110 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                  </svg>
                </div>
                <p class="text-xs font-semibold text-white leading-tight">Filo Paneli</p>
              </a>

              <a href="/company/connections" class="group rounded-xl bg-white/5 hover:bg-white/10 backdrop-blur ring-1 ring-white/10 hover:ring-white/25 px-3 py-4 transition text-center">
                <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-cyan-400/20 text-cyan-300 mb-2 group-hover:scale-110 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25" />
                  </svg>
                </div>
                <p class="text-xs font-semibold text-white leading-tight">Filo Davetleri</p>
              </a>

              <a href="/company/contracts" class="group rounded-xl bg-white/5 hover:bg-white/10 backdrop-blur ring-1 ring-white/10 hover:ring-white/25 px-3 py-4 transition text-center">
                <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-400/20 text-indigo-300 mb-2 group-hover:scale-110 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                </div>
                <p class="text-xs font-semibold text-white leading-tight">Sözleşmeler</p>
              </a>

              <% if (isAdmin) { %>
                <a href="/company/partnerships" class="group rounded-xl bg-white/5 hover:bg-white/10 backdrop-blur ring-1 ring-white/10 hover:ring-white/25 px-3 py-4 transition text-center">
                  <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-purple-400/20 text-purple-300 mb-2 group-hover:scale-110 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21" />
                    </svg>
                  </div>
                  <p class="text-xs font-semibold text-white leading-tight">İş Birlikleri</p>
                </a>

                <a href="/company/partnerships/invitations" class="group rounded-xl bg-white/5 hover:bg-white/10 backdrop-blur ring-1 ring-white/10 hover:ring-white/25 px-3 py-4 transition text-center">
                  <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-pink-400/20 text-pink-300 mb-2 group-hover:scale-110 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                    </svg>
                  </div>
                  <p class="text-xs font-semibold text-white leading-tight">Ortaklık Davetleri</p>
                </a>

                <a href="/partnerships/redeem" class="group rounded-xl bg-white/5 hover:bg-white/10 backdrop-blur ring-1 ring-white/10 hover:ring-white/25 px-3 py-4 transition text-center">
                  <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-amber-400/20 text-amber-300 mb-2 group-hover:scale-110 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                    </svg>
                  </div>
                  <p class="text-xs font-semibold text-white leading-tight">Ortaklığa Katıl</p>
                </a>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <div class="rounded-3xl bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200/60 px-6 py-5 flex items-start gap-4">
      <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 text-blue-600 flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
        </svg>
      </div>
      <div>
        <p class="font-semibold text-slate-800">Aktif çalışma alanı yok</p>
        <p class="text-sm text-slate-600 mt-0.5">Aşağıdaki listeden bir kuruma geç, yönetim araçlarına erişim aç.</p>
      </div>
    </div>
  <% } %>

  <!-- Kurumlar + Kişisel Alan — bento grid -->
  <div class="grid lg:grid-cols-3 gap-4">

    <!-- Kurumlar (lg: 2 kolon) -->
    <div class="lg:col-span-2 bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-6">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h3 class="text-lg font-bold text-slate-900">Bulunduğun Kurumlar</h3>
          <p class="text-xs text-slate-500 mt-0.5">Farklı kurumlarda farklı rollere sahip olabilirsin</p>
        </div>
        <a href="/companies/create"
           class="inline-flex items-center gap-1 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-800 transition">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Kurum ekle
        </a>
      </div>

      <% if (companies.length === 0) { %>
        <div class="text-center py-8">
          <p class="text-sm text-slate-500">Henüz hiçbir kuruma bağlı değilsin.</p>
        </div>
      <% } else { %>
        <ul class="space-y-2">
          <% companies.forEach(function(c) { %>
            <li class="group flex items-center gap-3 rounded-2xl px-3 py-3 hover:bg-slate-50 transition">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-slate-100 to-slate-200 text-slate-700 flex-shrink-0 font-bold text-sm">
                <%= (c.name || '?').trim()[0].toUpperCase() %>
              </span>
              <div class="flex-1 min-w-0">
                <div class="font-semibold text-slate-800 truncate"><%= c.name %></div>
                <div class="text-xs text-slate-500 mt-0.5 flex items-center gap-1.5 flex-wrap">
                  <span><%= c.role_display_name %></span>
                  <% if (!c.is_active) { %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-700">onay bekliyor</span>
                  <% } %>
                </div>
              </div>
              <% if (!currentCompany || currentCompany.id !== c.id) { %>
                <form action="/companies/switch" method="POST">
                  <input type="hidden" name="company_id" value="<%= c.id %>">
                  <button type="submit" class="rounded-lg bg-slate-100 text-slate-700 px-3 py-1.5 text-xs font-semibold hover:bg-slate-200 transition">
                    Geç
                  </button>
                </form>
              <% } else { %>
                <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-600">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  Aktif
                </span>
              <% } %>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <!-- Kişisel bildirim kartı -->
    <% const hasUnread = notificationUnreadCount > 0; %>
    <a href="/notifications"
       class="group relative rounded-3xl overflow-hidden text-white p-6 shadow-xl transition
              <%= hasUnread
                  ? 'bg-gradient-to-br from-red-500 via-orange-500 to-amber-500 shadow-orange-500/30 hover:shadow-orange-500/50'
                  : 'bg-gradient-to-br from-emerald-500 to-teal-600 shadow-emerald-500/30 hover:shadow-emerald-500/50' %>">
      <div class="absolute top-0 right-0 w-32 h-32 bg-white/20 rounded-full blur-2xl"></div>
      <% if (hasUnread) { %>
        <div class="absolute inset-0 opacity-40 mix-blend-overlay" style="background-image: linear-gradient(rgba(255,255,255,.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.4) 1px, transparent 1px); background-size: 24px 24px;"></div>
      <% } %>
      <div class="relative">
        <div class="flex items-start justify-between gap-2">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white/20 backdrop-blur ring-1 ring-white/30 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
            </svg>
          </div>
          <% if (hasUnread) { %>
            <span class="relative inline-flex h-2.5 w-2.5 mt-1">
              <span class="absolute inline-flex h-full w-full rounded-full bg-white/70 animate-ping"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
            </span>
          <% } %>
        </div>

        <% if (hasUnread) { %>
          <p class="text-5xl font-black tracking-tighter leading-none">
            <%= notificationUnreadCount %>
          </p>
          <p class="text-sm font-semibold mt-2">
            <%= notificationUnreadCount === 1 ? 'yeni bildirim' : 'yeni bildirim' %>
          </p>
          <p class="text-xs text-white/80 mt-1">Belge ve filo uyarıların bekliyor</p>
        <% } else { %>
          <p class="text-2xl font-bold tracking-tight">Bildirimlerim</p>
          <p class="text-sm text-emerald-100 mt-1 flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            Hepsi güncel
          </p>
        <% } %>

        <div class="inline-flex items-center gap-1 mt-4 text-sm font-semibold group-hover:translate-x-1 transition">
          <%= hasUnread ? 'Bildirimlere git' : 'Görüntüle' %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </div>
      </div>
    </a>
  </div>

  <!-- Kişisel alan hızlı erişim -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold text-slate-900">Kişisel Alanım</h3>
      <p class="text-xs text-slate-500">Profil ve araçlarını yönet</p>
    </div>
    <div class="grid sm:grid-cols-3 gap-4">

      <a href="/driver/profile" class="group relative bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 hover:shadow-soft-lg p-6 transition overflow-hidden">
        <div class="absolute -top-8 -right-8 w-32 h-32 bg-emerald-100 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
        <div class="relative">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 mb-4 group-hover:scale-110 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="font-bold text-slate-900 text-lg">Şoför Profilim</p>
          <p class="text-sm text-slate-500 mt-1">Kimlik ve belgeler</p>
        </div>
      </a>

      <a href="/vehicles" class="group relative bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 hover:shadow-soft-lg p-6 transition overflow-hidden">
        <div class="absolute -top-8 -right-8 w-32 h-32 bg-sky-100 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
        <div class="relative">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-sky-600 mb-4 group-hover:scale-110 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
          </div>
          <p class="font-bold text-slate-900 text-lg">Araçlarım</p>
          <p class="text-sm text-slate-500 mt-1">Araç ekle, belge yükle</p>
        </div>
      </a>

      <a href="/connections/redeem" class="group relative bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 hover:shadow-soft-lg p-6 transition overflow-hidden">
        <div class="absolute -top-8 -right-8 w-32 h-32 bg-indigo-100 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition"></div>
        <div class="relative">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600 mb-4 group-hover:scale-110 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
            </svg>
          </div>
          <p class="font-bold text-slate-900 text-lg">Filoya Katıl</p>
          <p class="text-sm text-slate-500 mt-1">Davet kodu ile</p>
        </div>
      </a>

    </div>
  </div>

</div>
