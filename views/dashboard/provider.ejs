<%
  const isManager = currentCompany && (currentCompany.role.name === 'company_admin' || currentCompany.role.name === 'company_moderator');
  const isAdmin   = currentCompany && currentCompany.role.name === 'company_admin';
  const health    = overview.fleetHealth;
  const partners  = overview.partnerships;
  const alerts    = overview.alerts;

  const total = health.combined.total || 0;
  const ready = health.combined.ready || 0;
  const warn  = health.combined.warning || 0;
  const prob  = health.combined.problem || 0;
  const pct   = total > 0 ? Math.round((ready / total) * 100) : 0;

  // Ring çizimi için: 2*PI*42 ≈ 263.9
  const CIRC = 263.9;
  const readyDash = total > 0 ? (ready / total) * CIRC : 0;
  const warnDash  = total > 0 ? (warn  / total) * CIRC : 0;
  const probDash  = total > 0 ? (prob  / total) * CIRC : 0;
%>

<div class="user-view">

  <!-- Hero -->
  <div class="b-hero">
    <div class="eyebrow">Hizmet sağlayıcı paneli</div>
    <h1><%= currentCompany.name %> <em>— bugünkü durum</em></h1>
    <div class="sub">
      <span class="pill role"><%= currentCompany.role.display_name %></span>
      <% if (currentCompany.is_active) { %>
        <span class="pill status"><span class="d"></span>Onaylı kurum</span>
      <% } else { %>
        <span class="pill warn">SuperAdmin onayı bekliyor</span>
      <% } %>
      <span><%= total %> üye · <%= partners.length %> aktif iş ortaklığı</span>
      <form action="/companies/clear" method="POST" style="margin:0;">
        <button type="submit" class="exit">Alandan çık</button>
      </form>
    </div>
  </div>

  <div class="bento provider">

    <!-- Filo Hazırlığı (ring) -->
    <div class="cell dark health">
      <div class="cell-head">
        <span class="cell-title">Filo hazırlığı</span>
        <a href="/company/fleet/drivers" class="cell-action">Detay →</a>
      </div>
      <div class="ring-wrap">
        <div class="ring">
          <svg viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="42" fill="none" stroke="rgba(255,255,255,0.10)" stroke-width="10"/>
            <% if (readyDash > 0) { %>
              <circle cx="50" cy="50" r="42" fill="none" stroke="#10B981" stroke-width="10"
                stroke-dasharray="<%= readyDash %> <%= CIRC %>" stroke-dashoffset="0"/>
            <% } %>
            <% if (warnDash > 0) { %>
              <circle cx="50" cy="50" r="42" fill="none" stroke="#F59E0B" stroke-width="10"
                stroke-dasharray="<%= warnDash %> <%= CIRC %>" stroke-dashoffset="<%= -readyDash %>"/>
            <% } %>
            <% if (probDash > 0) { %>
              <circle cx="50" cy="50" r="42" fill="none" stroke="#DC2626" stroke-width="10"
                stroke-dasharray="<%= probDash %> <%= CIRC %>" stroke-dashoffset="<%= -(readyDash + warnDash) %>"/>
            <% } %>
          </svg>
          <div class="center">
            <div class="pct">%<%= pct %></div>
            <div class="lbl">Hazır</div>
          </div>
        </div>
        <div class="ring-side">
          <div class="ring-row"><span class="swatch" style="background:#10B981;"></span><span class="name">Hazır</span><span class="n"><%= ready %></span></div>
          <div class="ring-row"><span class="swatch" style="background:#F59E0B;"></span><span class="name">Uyarı</span><span class="n"><%= warn %></span></div>
          <div class="ring-row"><span class="swatch" style="background:#DC2626;"></span><span class="name">Problem</span><span class="n"><%= prob %></span></div>
        </div>
      </div>
      <div class="divider">
        <span><%= health.drivers.total %> şoför · <%= health.vehicles.total %> araç</span>
        <strong><%= total %> üye</strong>
      </div>
    </div>

    <!-- KPI: Toplam filo -->
    <div class="cell kpi-total">
      <div class="cell-head">
        <span class="cell-title">Toplam filo</span>
      </div>
      <div class="big-num"><%= total %></div>
      <div style="font-family:'JetBrains Mono',ui-monospace,monospace; font-size:11px; color:var(--muted);">
        <strong style="color:var(--ink); font-weight:600;"><%= health.drivers.total %></strong> şoför ·
        <strong style="color:var(--ink); font-weight:600;"><%= health.vehicles.total %></strong> araç
      </div>
    </div>

    <!-- KPI: Ortaklar -->
    <div class="cell kpi-partners">
      <div class="cell-head">
        <span class="cell-title">Aktif iş ortağı</span>
      </div>
      <div class="big-num"><%= partners.length %></div>
      <div style="font-family:'JetBrains Mono',ui-monospace,monospace; font-size:11px; color:var(--muted);">
        <% const alanCount = partners.filter(p => p.partnerType === 'receiver').length; %>
        <% const saglayanCount = partners.filter(p => p.partnerType === 'provider').length; %>
        <strong style="color:var(--ink); font-weight:600;"><%= alanCount %></strong> alan ·
        <strong style="color:var(--ink); font-weight:600;"><%= saglayanCount %></strong> sağlayan
      </div>
    </div>

    <!-- Kritik Uyarılar -->
    <div class="cell alerts-cell">
      <div class="cell-head">
        <span class="cell-title">Kritik uyarılar<% if (alerts.length > 0) { %> · <%= alerts.length %><% } %></span>
        <a href="/company/fleet/drivers" class="cell-action">Filoya git →</a>
      </div>
      <% if (alerts.length === 0) { %>
        <div class="empty">
          <div class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <h4>Her şey yolunda</h4>
          <p>Filondaki tüm belgeler geçerli.</p>
        </div>
      <% } else { %>
        <div class="alerts">
          <% alerts.forEach(function(a) { %>
            <a href="/company/fleet/<%= a.kind === 'driver' ? 'drivers' : (a.kind === 'vehicle' ? 'vehicles' : 'hostesses') %>/<%= a.profileId %>" class="alert <%= a.status === 'problem' ? 'crit' : 'warn' %>">
              <div class="bar"></div>
              <span class="av"><%= (a.name || '?').trim().split(/\s+/).map(w => w[0]).slice(0,2).join('').toUpperCase() %></span>
              <div class="body">
                <div class="name">
                  <%= a.name %>
                  <span class="type"><%= a.kind === 'driver' ? 'şoför' : (a.kind === 'vehicle' ? 'araç' : 'hostes') %></span>
                </div>
                <% if (a.issues && a.issues.length > 0) { %>
                  <div class="msg"><%= a.issues[0] %><% if (a.issues.length > 1) { %> · <span class="m">+<%= a.issues.length - 1 %> daha</span><% } %></div>
                <% } %>
              </div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Aktif İş Ortakları -->
    <div class="cell partners-cell">
      <div class="cell-head">
        <span class="cell-title">İş ortakları · <%= partners.length %></span>
        <% if (isAdmin) { %><a href="/company/partnerships" class="cell-action">Tümü →</a><% } %>
      </div>
      <% if (partners.length === 0) { %>
        <div class="empty">
          <div class="icn" style="background:var(--surface-3); color:var(--muted);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div>
          <h4>Henüz iş ortaklığın yok</h4>
          <% if (isAdmin) { %>
            <p><a href="/company/partnerships/invitations/create" style="color:var(--nav); font-weight:600;">Davet üret</a> ya da <a href="/partnerships/redeem" style="color:var(--nav); font-weight:600;">kod ile katıl</a></p>
          <% } %>
        </div>
      <% } else { %>
        <div class="partners">
          <% partners.forEach(function(p) { %>
            <a href="<%= isAdmin ? '/company/partnerships/' + p.id : '#' %>" class="partner">
              <span class="logo"><%= (p.partnerName || '?').trim()[0].toUpperCase() %></span>
              <div class="info">
                <div class="n"><%= p.partnerName %></div>
                <div class="t"><%= p.partnerType === 'provider' ? 'sağlayıcı' : 'alıcı' %></div>
              </div>
              <span class="status ok"><span class="d"></span>aktif</span>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Davet / hızlı -->
    <div class="cell invite-cell accent">
      <div class="cell-head">
        <span class="cell-title">Filo daveti</span>
      </div>
      <div style="font-size:13.5px; color:var(--accent-3); line-height:1.5; font-weight:500;">
        Şoför, araç ya da hostes davet edip filona katılmalarını sağla.
      </div>
      <a href="/company/connections" style="align-self:flex-start; margin-top:6px; display:inline-flex; align-items:center; gap:6px; padding:8px 14px; background:var(--accent-3); color:white; border-radius:8px; font-size:13px; font-weight:600; letter-spacing:-0.005em;">
        Davet üret
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <!-- Yönetim araçları -->
    <% if (isManager) { %>
      <div class="cell tools-cell">
        <div class="cell-head"><span class="cell-title">Yönetim araçları</span></div>
        <div class="tools-grid">
          <a href="/company/fleet/drivers" class="tool navy">
            <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2"/></svg></span>
            <div class="l"><div class="t">Filo paneli</div><div class="d"><%= total %> üye</div></div>
          </a>
          <a href="/company/connections" class="tool blue">
            <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v6H4z"/><path d="M4 14h16v6H4z"/></svg></span>
            <div class="l"><div class="t">Filo davetleri</div><div class="d">şoför / araç / hostes</div></div>
          </a>
          <a href="/company/contracts" class="tool amber">
            <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
            <div class="l"><div class="t">Sözleşmeler</div><div class="d">şablonlar</div></div>
          </a>
          <% if (isAdmin) { %>
            <a href="/company/partnerships" class="tool green">
              <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M6 18V9a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v9"/></svg></span>
              <div class="l"><div class="t">İş birlikleri</div><div class="d"><%= partners.length %> aktif</div></div>
            </a>
            <a href="/company/partnerships/invitations" class="tool navy">
              <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></span>
              <div class="l"><div class="t">Ortaklık davetleri</div><div class="d">kod üret</div></div>
            </a>
            <a href="/partnerships/redeem" class="tool amber">
              <span class="icn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M7 8V6a5 5 0 0 1 10 0v2"/></svg></span>
              <div class="l"><div class="t">Ortaklığa katıl</div><div class="d">kod ile</div></div>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>
</div>
