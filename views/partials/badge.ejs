<%
  const _badgeMap = {
    success: 'bg-emerald-100 text-emerald-700',
    warning: 'bg-amber-100 text-amber-700',
    danger:  'bg-red-100 text-red-700',
    info:    'bg-blue-100 text-blue-700',
    muted:   'bg-slate-100 text-slate-600',
  };
  const _badgeCls = _badgeMap[typeof type !== 'undefined' ? type : 'muted'] || _badgeMap.muted;
%><span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= _badgeCls %>"><%= text %></span>
