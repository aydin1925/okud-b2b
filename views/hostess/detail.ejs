<%
  const statusStyle = {
    active:       { pill: 'bg-emerald-50 text-emerald-700 border-emerald-200', dot: 'bg-emerald-500', label: 'Aktif' },
    pending_docs: { pill: 'bg-amber-50 text-amber-800 border-amber-200',       dot: 'bg-amber-500',   label: 'Belge bekliyor' },
    inactive:     { pill: 'bg-slate-100 text-slate-600 border-slate-200',      dot: 'bg-slate-400',   label: 'Pasif' },
  }[hostess.status] || { pill: 'bg-slate-100 text-slate-600', dot: 'bg-slate-400', label: hostess.status };

  const verifiedCount = requiredTypes.filter(t => documentsByType[t] && documentsByType[t].verification_status === 'verified').length;
%>

<div class="max-w-4xl mx-auto space-y-6">

  <a href="/hostess" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
    Hosteslerim
  </a>

  <!-- Hostes hero -->
  <div class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 overflow-hidden">
    <div class="p-5 sm:p-8">
      <div class="flex items-start gap-4 flex-wrap">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-pink-500 to-purple-600 text-white font-bold text-xl shadow-xl shadow-pink-500/25 flex-shrink-0">
          <%= hostess.first_name[0] %><%= hostess.last_name[0] %>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Hostes profili</p>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight"><%= hostess.first_name %> <%= hostess.last_name %></h1>
          <div class="flex items-center gap-2 mt-2 flex-wrap">
            <span class="inline-flex items-center gap-1.5 rounded-full border <%= statusStyle.pill %> px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-widest">
              <span class="h-1.5 w-1.5 rounded-full <%= statusStyle.dot %>"></span>
              <%= statusStyle.label %>
            </span>
            <span class="text-xs text-slate-500">
              <%= verifiedCount %>/<%= requiredTypes.length %> belge onaylı
            </span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-6 border-t border-slate-100 grid sm:grid-cols-2 gap-4 text-sm">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">TC Kimlik</p>
          <p class="font-semibold text-slate-700 font-mono"><%= hostess.national_id %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">Doğum Tarihi</p>
          <p class="font-semibold text-slate-700"><%= hostess.birth_date %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">Telefon</p>
          <p class="font-semibold text-slate-700"><%= hostess.phone || '—' %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">Kayıt Tarihi</p>
          <p class="font-semibold text-slate-700"><%= hostess.created_at %></p>
        </div>
      </div>

      <% if (hostess.notes) { %>
        <div class="mt-4 pt-4 border-t border-slate-100">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Not</p>
          <p class="text-sm text-slate-700 whitespace-pre-line"><%= hostess.notes %></p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Belgeler -->
  <div class="bg-white rounded-3xl shadow-soft ring-1 ring-slate-900/5 p-5 sm:p-8">
    <div class="mb-5">
      <h2 class="text-lg font-bold text-slate-900">Belgeler</h2>
      <p class="text-xs text-slate-500">Sistem hostes için şu belgeleri bekler: <%= requiredTypes.map(t => typeLabels[t]).join(' · ') %></p>
    </div>

    <% if (requiredTypes.length === 0) { %>
      <p class="text-sm text-slate-500">Hostes için tanımlı belge yok.</p>
    <% } else { %>
      <ul class="space-y-2 mb-6">
        <% requiredTypes.forEach(function(type) {
          const doc = documentsByType[type];
        %>
          <li class="flex items-start gap-3 p-3 rounded-2xl border <%=
            doc && doc.verification_status === 'verified' ? 'bg-emerald-50/50 border-emerald-200' :
            doc && doc.verification_status === 'rejected' ? 'bg-red-50/50 border-red-200' :
            doc                                            ? 'bg-amber-50/50 border-amber-200' :
                                                             'bg-slate-50 border-slate-200'
          %>">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg flex-shrink-0 <%=
              doc && doc.verification_status === 'verified' ? 'bg-emerald-100 text-emerald-600' :
              doc && doc.verification_status === 'rejected' ? 'bg-red-100 text-red-600' :
              doc                                            ? 'bg-amber-100 text-amber-700' :
                                                               'bg-slate-100 text-slate-400'
            %>">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </span>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-sm text-slate-900"><%= typeLabels[type] %></p>
              <% if (!doc) { %>
                <p class="text-xs text-slate-500 mt-0.5">Henüz yüklenmedi</p>
              <% } else { %>
                <div class="grid grid-cols-2 gap-3 mt-1 text-xs">
                  <div>
                    <span class="text-slate-400">Yüklendi:</span>
                    <span class="font-semibold text-slate-700"><%= doc.created_at %></span>
                  </div>
                  <% if (doc.expires_at) { %>
                    <div>
                      <span class="text-slate-400">Son Geç.:</span>
                      <span class="font-semibold text-slate-700"><%= doc.expires_at %></span>
                    </div>
                  <% } %>
                </div>
                <div class="mt-1.5">
                  <% if (doc.verification_status === 'verified') { %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 text-emerald-700 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest">Onaylı</span>
                  <% } else if (doc.verification_status === 'rejected') { %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-red-100 text-red-700 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest">Reddedildi</span>
                    <% if (doc.rejection_reason) { %>
                      <p class="text-xs text-red-700 mt-1">Sebep: <%= doc.rejection_reason %></p>
                    <% } %>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 text-amber-700 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest">Onay bekliyor</span>
                  <% } %>
                </div>
              <% } %>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>

    <!-- Belge yükleme formu -->
    <div class="pt-6 border-t border-slate-100">
      <div class="mb-4">
        <h3 class="text-lg font-bold text-slate-900">Belge Yükle</h3>
        <p class="text-xs text-slate-500">JPG, PNG, WEBP veya PDF · Max 5 MB</p>
      </div>

      <form id="hostessDocumentUploadForm" action="/hostess/<%= hostess.id %>/documents/upload" method="POST" enctype="multipart/form-data" class="space-y-4"
            data-perpetual-types='<%- JSON.stringify(perpetualTypes) %>'>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="document_type" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Belge Türü</label>
            <select id="document_type" name="document_type" required
                    class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
              <option value="">Seçiniz</option>
              <% requiredTypes.forEach(function(type) { %>
                <option value="<%= type %>"><%= typeLabels[type] %></option>
              <% }); %>
            </select>
          </div>
          <div id="expiresAtWrapper">
            <label for="expires_at" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Son Geçerlilik <span class="text-slate-400 font-normal normal-case">(opsiyonel)</span></label>
            <input type="date" id="expires_at" name="expires_at"
                   class="w-full rounded-xl border-0 ring-1 ring-slate-200 bg-white px-4 py-3 focus:ring-2 focus:ring-slate-900 focus:outline-none transition">
            <p id="perpetualHint" class="hidden mt-2 text-xs text-slate-500 italic">Bu belge süresizdir, tarih girmene gerek yok.</p>
            <p id="criminalRecordHint" class="hidden mt-2 text-xs text-amber-700">💡 Sabıka kaydı genellikle 1 yıl geçerli sayılır.</p>
          </div>
        </div>
        <div>
          <label for="file" class="block text-xs font-bold uppercase tracking-widest text-slate-600 mb-2">Dosya</label>
          <input type="file" id="file" name="file" accept=".jpg,.jpeg,.png,.webp,.pdf" required
                 class="w-full text-sm text-slate-600 file:mr-3 file:rounded-xl file:border-0 file:bg-slate-900 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-white hover:file:bg-slate-800 file:transition file:cursor-pointer">
        </div>
        <button type="submit"
                class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800 transition shadow-lg shadow-slate-900/25">
          Yükle
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" /></svg>
        </button>
      </form>

      <script>
        (function () {
          const form         = document.getElementById('hostessDocumentUploadForm');
          if (!form) return;
          const typeSelect   = form.querySelector('#document_type');
          const dateInput    = form.querySelector('#expires_at');
          const perpetualMsg = form.querySelector('#perpetualHint');
          const criminalMsg  = form.querySelector('#criminalRecordHint');
          const perpetual    = JSON.parse(form.dataset.perpetualTypes || '[]');

          typeSelect.addEventListener('change', function () {
            const type = typeSelect.value;
            const isPerpetual = perpetual.includes(type);
            if (isPerpetual) {
              dateInput.value = '';
              dateInput.disabled = true;
              dateInput.classList.add('opacity-40', 'cursor-not-allowed');
              perpetualMsg.classList.remove('hidden');
            } else {
              dateInput.disabled = false;
              dateInput.classList.remove('opacity-40', 'cursor-not-allowed');
              perpetualMsg.classList.add('hidden');
            }
            if (type === 'criminal_record') {
              criminalMsg.classList.remove('hidden');
            } else {
              criminalMsg.classList.add('hidden');
            }
          });
        })();
      </script>
    </div>
  </div>

  <!-- (Sahibi tarafı pasife alma UI'ı geçici kaldırıldı.) -->

  <!-- Tehlikeli Bölge: Hostesi filodan çıkar -->
  <div class="bg-white rounded-2xl shadow-soft ring-1 ring-red-200/50 overflow-hidden">
    <div class="p-5 sm:p-6">
      <div class="flex items-start gap-3 mb-3">
        <div class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-100 text-red-600 flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166M18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79" />
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-red-700">Tehlikeli Bölge</h3>
          <p class="text-sm text-slate-600 mt-0.5">
            Hostesi filodan çıkardığında, bağlı olduğu aracın filo uyumu yeniden hesaplanır.
            Belgeleri diskte kalır, geri getirme özelliği yok.
          </p>
        </div>
      </div>
      <button type="button"
              onclick="document.getElementById('hostessDeleteDialog').showModal()"
              class="inline-flex items-center gap-1.5 rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-500 transition shadow-lg shadow-red-500/25">
        Hostesi Filodan Çıkar
      </button>

      <dialog id="hostessDeleteDialog" class="rounded-3xl p-0 w-full max-w-md backdrop:bg-slate-900/60">
        <form method="POST" action="/hostess/<%= hostess.id %>/delete" class="bg-white rounded-3xl overflow-hidden">
          <div class="px-6 py-5">
            <h3 class="text-lg font-bold text-slate-900">Hostesi Filodan Çıkar</h3>
            <p class="text-sm text-slate-600 mt-2"><strong><%= hostess.first_name %> <%= hostess.last_name %></strong> filondan çıkacak. İşlem geri alınamaz.</p>
          </div>
          <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50 flex items-center justify-end gap-2">
            <button type="button" onclick="document.getElementById('hostessDeleteDialog').close()" class="inline-flex items-center rounded-lg px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">Vazgeç</button>
            <button type="submit" class="inline-flex items-center rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-500 transition shadow-lg shadow-red-500/25">Evet, çıkar</button>
          </div>
        </form>
      </dialog>
    </div>
  </div>
</div>
