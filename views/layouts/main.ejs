<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= title %> — Filoskope</title>

  <!-- Fonts: Inter (marka fontu) + JetBrains Mono (utility) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Kullanıcı dashboard sistemi (Palet 1 tokens + bento/k-* class'ları — .user-view scope'unda) -->
  <link rel="stylesheet" href="/css/user.css">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans:  ['Inter', 'system-ui', '-apple-system', 'Segoe UI', 'sans-serif'],
            serif: ['Inter', 'system-ui', 'sans-serif'],
            mono:  ['"JetBrains Mono"', 'ui-monospace', 'monospace'],
          },
          boxShadow: {
            'soft':    '0 1px 2px 0 rgb(15 23 42 / 0.04), 0 1px 3px 0 rgb(15 23 42 / 0.06)',
            'soft-lg': '0 4px 6px -1px rgb(15 23 42 / 0.05), 0 2px 4px -2px rgb(15 23 42 / 0.04)',
            'soft-xl': '0 10px 15px -3px rgb(15 23 42 / 0.06), 0 4px 6px -4px rgb(15 23 42 / 0.05)',
            'glow-blue':   '0 0 40px -10px rgb(59 130 246 / 0.5)',
            'glow-purple': '0 0 40px -10px rgb(168 85 247 / 0.5)',
          },
          animation: {
            'blob':      'blob 20s infinite',
            'fade-up':   'fade-up 0.5s ease-out',
            'shimmer':   'shimmer 2s linear infinite',
          },
          keyframes: {
            blob: {
              '0%, 100%': { transform: 'translate(0px, 0px) scale(1)' },
              '33%':      { transform: 'translate(30px, -50px) scale(1.1)' },
              '66%':      { transform: 'translate(-20px, 20px) scale(0.9)' },
            },
            'fade-up': {
              '0%':   { opacity: '0', transform: 'translateY(10px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            },
            shimmer: {
              '0%':   { backgroundPosition: '-1000px 0' },
              '100%': { backgroundPosition: '1000px 0' },
            },
          },
        },
      },
    };
  </script>

  <!-- Tabler icons (navbar) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.0.0/dist/tabler-icons.min.css">

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    /* SweetAlert Inter + rounded */
    .swal2-popup { font-family: 'Inter', system-ui, sans-serif !important; border-radius: 20px !important; padding: 1.75rem !important; }
    .swal2-title { font-weight: 800 !important; font-size: 1.25rem !important; }
    .swal2-html-container { color: rgb(71 85 105) !important; font-size: 0.95rem !important; }
    .swal2-confirm, .swal2-cancel { border-radius: 12px !important; font-weight: 600 !important; padding: 0.6rem 1.25rem !important; font-size: 0.9rem !important; }
    .swal2-styled.swal2-confirm { background-color: #dc2626 !important; box-shadow: 0 8px 20px -6px rgba(220, 38, 38, 0.5) !important; }
    .swal2-styled.swal2-confirm.confirm-blue { background-color: #0f2a4a !important; box-shadow: 0 8px 20px -6px rgba(15, 42, 74, 0.5) !important; }
    .swal2-styled.swal2-cancel { background-color: rgb(241 245 249) !important; color: rgb(51 65 85) !important; }

    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgb(203 213 225); border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: rgb(148 163 184); }

    /* ═══════ NAVBAR — Filoskope (Palet 1) ═══════ */
    .okud-nav {
      background: white;
      border-radius: 14px;
      box-shadow: 0 0 0 1px rgba(15,42,74,0.08), 0 1px 3px rgba(15,42,74,0.04);
      padding: 10px 16px;
      display: flex; align-items: center; gap: 16px;
    }
    .okud-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }
    .okud-brand .logo {
      position: relative; width: 34px; height: 34px; background: #0F2A4A;
      border-radius: 9px; color: white;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 15px; letter-spacing: -0.02em;
    }
    .okud-brand .logo::after {
      content: ''; position: absolute; bottom: -2px; right: -2px;
      width: 9px; height: 9px; background: #F59E0B; border-radius: 50%;
      box-shadow: 0 0 0 2.5px white;
    }
    .okud-brand .name {
      font-weight: 700; font-size: 17px; letter-spacing: -0.02em; color: #0F2A4A;
    }
    .okud-brand:hover .logo { transform: rotate(-3deg); transition: transform 200ms cubic-bezier(0.16,1,0.3,1); }

    .okud-links { display: flex; align-items: center; gap: 2px; }
    .okud-link {
      position: relative;
      padding: 8px 12px; font-size: 13.5px; font-weight: 500;
      color: #64748B; text-decoration: none;
      border-radius: 8px; white-space: nowrap;
      transition: color 150ms ease, background 150ms ease;
    }
    .okud-link:hover { color: #0F172A; background: rgba(15,42,74,0.04); }
    .okud-link.active { color: #0F172A; font-weight: 600; }
    .okud-link.active::after {
      content: ''; position: absolute; left: 12px; right: 12px; bottom: 2px;
      height: 2px; background: #F59E0B; border-radius: 2px;
    }

    .okud-company-pill {
      display: inline-flex; align-items: center; gap: 8px;
      background: #F5F5F3; border: 1px solid rgba(15,42,74,0.08);
      border-radius: 999px; padding: 5px 12px 5px 5px;
      cursor: pointer; text-decoration: none;
      transition: background 150ms ease, border-color 150ms ease;
    }
    .okud-company-pill:hover { background: white; border-color: rgba(15,42,74,0.16); }
    .okud-company-pill .av {
      width: 22px; height: 22px; border-radius: 50%; background: #0F2A4A;
      color: white; font-size: 10px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .okud-company-pill .nm {
      font-size: 12px; font-weight: 600; color: #0F172A;
      max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .okud-company-pill .ic { font-size: 13px; color: #94A3B8; }

    .okud-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
    .okud-bell-wrap { position: relative; }
    .okud-icon-btn {
      position: relative; width: 36px; height: 36px; border-radius: 9px;
      background: transparent; border: none; color: #475569;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; text-decoration: none;
      transition: background 150ms ease, color 150ms ease;
    }
    .okud-icon-btn:hover, .okud-icon-btn[aria-expanded="true"] { background: rgba(15,42,74,0.06); color: #0F172A; }
    .okud-icon-btn .ic { font-size: 18px; }
    .okud-icon-btn .badge {
      position: absolute; top: 5px; right: 6px;
      min-width: 16px; height: 16px; padding: 0 4px;
      background: #DC2626; color: white; font-size: 10px; font-weight: 700;
      border-radius: 8px; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 0 0 2px white;
    }

    .okud-avatar-wrap { position: relative; }
    .okud-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: #0F2A4A; color: white; font-weight: 700; font-size: 12px;
      border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: box-shadow 200ms ease;
    }
    .okud-avatar:hover, .okud-avatar[aria-expanded="true"] {
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.20);
    }

    .okud-dropdown {
      position: absolute; top: calc(100% + 8px); right: 0;
      width: 240px; background: white; border-radius: 12px;
      box-shadow: 0 0 0 1px rgba(15,42,74,0.08), 0 12px 24px -8px rgba(15,42,74,0.18);
      padding: 6px; z-index: 40;
      opacity: 0; transform: translateY(-4px); pointer-events: none;
      transition: opacity 150ms ease, transform 150ms ease;
    }
    .okud-dropdown.open { opacity: 1; transform: translateY(0); pointer-events: auto; }

    /* Bildirim popover */
    .okud-bell-popover {
      position: absolute; top: calc(100% + 8px); right: 0;
      width: 340px; max-width: calc(100vw - 32px);
      background: white; border-radius: 12px;
      box-shadow: 0 0 0 1px rgba(15,42,74,0.08), 0 12px 24px -8px rgba(15,42,74,0.18);
      z-index: 40; overflow: hidden;
      opacity: 0; transform: translateY(-4px); pointer-events: none;
      transition: opacity 150ms ease, transform 150ms ease;
    }
    .okud-bell-popover.open { opacity: 1; transform: translateY(0); pointer-events: auto; }
    .okud-bell-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 14px; border-bottom: 1px solid rgba(15,42,74,0.06);
    }
    .okud-bell-head .t { font-size: 13px; font-weight: 700; color: #0F172A; }
    .okud-bell-head .cnt {
      font-size: 11px; color: white; background: #DC2626;
      padding: 2px 7px; border-radius: 999px; font-weight: 700;
    }
    .okud-bell-head .cnt.zero { background: rgba(15,42,74,0.08); color: #64748B; }
    .okud-bell-list { max-height: 380px; overflow-y: auto; }
    .okud-bell-item {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 11px 14px; border-bottom: 1px solid rgba(15,42,74,0.04);
      text-decoration: none; color: inherit;
    }
    .okud-bell-item:last-child { border-bottom: none; }
    .okud-bell-item:hover { background: rgba(15,42,74,0.03); }
    .okud-bell-item.unread { background: rgba(245, 158, 11, 0.05); }
    .okud-bell-item .dot {
      width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex-shrink: 0;
      background: transparent;
    }
    .okud-bell-item.unread .dot { background: #F59E0B; box-shadow: 0 0 0 2px rgba(245,158,11,0.20); }
    .okud-bell-item .info { flex: 1; min-width: 0; }
    .okud-bell-item .info .tt {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 13px; font-weight: 500; color: #0F172A; line-height: 1.4;
      overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
      -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    }
    .okud-bell-item.unread .info .tt { font-weight: 600; }
    .okud-bell-item .info .mt {
      font-size: 11px; color: #94A3B8; margin-top: 3px;
      display: flex; align-items: center; gap: 6px;
    }
    .okud-bell-item .info .mt .comp {
      color: #0F2A4A; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .okud-bell-empty {
      padding: 30px 20px; text-align: center; color: #94A3B8; font-size: 13px;
    }
    .okud-bell-empty i { font-size: 28px; color: #CBD5E1; margin-bottom: 8px; display: block; }
    .okud-bell-loading { padding: 24px; text-align: center; color: #94A3B8; font-size: 12px; }
    .okud-bell-foot {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      padding: 10px 14px; border-top: 1px solid rgba(15,42,74,0.06);
      background: #FAFAF9;
      color: #0F2A4A; font-size: 12.5px; font-weight: 600;
      text-decoration: none;
    }
    .okud-bell-foot:hover { background: white; }
    .okud-bell-foot .ic { font-size: 14px; }

    /* E-posta doğrulama bandı */
    .okud-verify-wrap { margin-top: 40px; }
    .okud-verify-banner {
      padding: 12px 16px;
      background: #FEF3C7; border: 1px solid #FDE68A; border-radius: 12px;
      display: flex; align-items: center; gap: 12px;
      font-size: 13px; color: #78350F;
      box-shadow: 0 1px 2px rgba(15,42,74,0.03);
    }
    .okud-verify-banner .ic {
      width: 32px; height: 32px; border-radius: 9px;
      background: rgba(180, 83, 9, 0.15); color: #B45309;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 18px;
    }
    .okud-verify-banner .msg { flex: 1; min-width: 0; line-height: 1.4; }
    .okud-verify-banner .msg b { color: #78350F; font-weight: 700; }
    .okud-verify-banner form { margin: 0; flex-shrink: 0; }
    .okud-verify-banner button {
      background: #78350F; color: white; border: none; border-radius: 8px;
      padding: 8px 14px; font-size: 12.5px; font-weight: 600; cursor: pointer;
      font-family: inherit; white-space: nowrap;
      display: inline-flex; align-items: center; gap: 6px;
      transition: background 150ms ease;
    }
    .okud-verify-banner button:hover { background: #92400E; }
    .okud-verify-banner button i { font-size: 14px; }
    .okud-verify-banner .sent {
      background: rgba(120, 53, 15, 0.10); color: #78350F;
      padding: 8px 14px; border-radius: 8px; font-size: 12.5px; font-weight: 600;
      white-space: nowrap;
    }
    @media (max-width: 640px) {
      .okud-verify-banner {
        flex-wrap: wrap; padding: 12px 14px; gap: 10px;
      }
      .okud-verify-banner .msg { flex: 1 1 100%; order: 2; }
      .okud-verify-banner .ic { order: 1; }
      .okud-verify-banner form,
      .okud-verify-banner .sent { flex: 1 1 100%; order: 3; }
      .okud-verify-banner button { width: 100%; justify-content: center; }
    }

    /* Şifre göster/gizle — global (input[type=password]) */
    .pw-wrap { position: relative; display: block; }
    .pw-wrap input { padding-right: 42px; }
    .pw-toggle {
      position: absolute; top: 50%; right: 6px;
      transform: translateY(-50%);
      width: 30px; height: 30px; border-radius: 7px;
      background: transparent; border: none; cursor: pointer;
      color: #94A3B8; padding: 0;
      display: flex; align-items: center; justify-content: center;
      transition: background 150ms ease, color 150ms ease;
    }
    .pw-toggle:hover { color: #0F2A4A; background: rgba(15,42,74,0.08); }
    .pw-toggle:focus-visible { outline: 2px solid #0F2A4A; outline-offset: 1px; }
    .pw-toggle i { font-size: 16px; }
    .okud-dd-head {
      padding: 12px 12px 10px;
      border-bottom: 1px solid rgba(15,42,74,0.06);
    }
    .okud-dd-head .n { font-size: 13px; font-weight: 600; color: #0F172A; }
    .okud-dd-head .m { font-size: 11px; color: #64748B; margin-top: 2px; word-break: break-all; }
    .okud-dd-item {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 10px; border-radius: 8px;
      font-size: 13px; color: #0F172A; text-decoration: none;
      background: transparent; border: none; cursor: pointer;
      width: 100%; text-align: left; font-family: inherit;
    }
    .okud-dd-item:hover { background: rgba(15,42,74,0.05); }
    .okud-dd-item .ic { font-size: 16px; color: #64748B; flex-shrink: 0; }
    .okud-dd-item.is-admin .ic { color: #7C3AED; }
    .okud-dd-item.is-danger { color: #DC2626; }
    .okud-dd-item.is-danger .ic { color: #DC2626; }
    .okud-dd-sep { height: 1px; background: rgba(15,42,74,0.06); margin: 6px 4px; }

    .okud-burger {
      display: none;
      margin-left: auto;
      width: 38px; height: 38px; border-radius: 9px;
      background: rgba(15,42,74,0.06); color: #0F2A4A;
      border: none; cursor: pointer;
      align-items: center; justify-content: center;
      position: relative;
    }
    .okud-burger .ic { font-size: 20px; }
    .okud-burger .badge {
      position: absolute; top: 6px; right: 6px;
      width: 8px; height: 8px; background: #DC2626; border-radius: 50%;
      box-shadow: 0 0 0 2px white;
    }

    @media (max-width: 900px) {
      .okud-nav { gap: 12px; padding: 10px 12px; }
      .okud-links, .okud-company-pill, .okud-actions { display: none; }
      .okud-burger { display: inline-flex; }
    }

    /* Mobil menü — sadeleştirilmiş */
    .okud-mobile-menu {
      margin-top: 8px; background: white; border-radius: 14px;
      box-shadow: 0 0 0 1px rgba(15,42,74,0.08), 0 8px 24px -12px rgba(15,42,74,0.14);
      overflow: hidden;
    }
    .okud-mobile-menu.hidden { display: none; }
    .okud-mobile-head {
      padding: 14px 16px; background: #F5F5F3;
      border-bottom: 1px solid rgba(15,42,74,0.06);
      display: flex; align-items: center; gap: 12px;
    }
    .okud-mobile-head .av {
      width: 38px; height: 38px; border-radius: 50%; background: #0F2A4A;
      color: white; font-size: 13px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .okud-mobile-head .n { font-size: 14px; font-weight: 700; color: #0F172A; }
    .okud-mobile-head .m {
      font-size: 11px; color: #64748B; display: flex; align-items: center; gap: 6px; margin-top: 2px;
    }
    .okud-mobile-head .m::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%; background: #F59E0B;
    }
    .okud-mobile-links { padding: 6px; display: flex; flex-direction: column; gap: 1px; }
    .okud-mobile-links a, .okud-mobile-links button {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 12px; border-radius: 10px;
      font-size: 14px; font-weight: 500; color: #0F172A;
      text-decoration: none; background: transparent; border: none;
      width: 100%; text-align: left; font-family: inherit; cursor: pointer;
    }
    .okud-mobile-links a:hover, .okud-mobile-links button:hover { background: rgba(15,42,74,0.05); }
    .okud-mobile-links .ic { font-size: 18px; color: #64748B; flex-shrink: 0; }
    .okud-mobile-links .admin { color: #7C3AED; }
    .okud-mobile-links .admin .ic { color: #7C3AED; }
    .okud-mobile-links .logout { color: #DC2626; margin-top: 4px; border-top: 1px solid rgba(15,42,74,0.06); border-radius: 0 0 10px 10px; padding-top: 12px; }
    .okud-mobile-links .logout .ic { color: #DC2626; }
    .okud-mobile-links .badge {
      margin-left: auto; min-width: 22px; height: 22px; padding: 0 6px;
      background: #DC2626; color: white; font-size: 11px; font-weight: 700;
      border-radius: 11px; display: flex; align-items: center; justify-content: center;
    }

    /* Dialog soft-open animasyonu — sadece <dialog> elementleri için */
    dialog {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
      transition:
        opacity 200ms ease,
        transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
        overlay 200ms ease allow-discrete,
        display 200ms ease allow-discrete;
    }
    dialog[open] {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    @starting-style {
      dialog[open] {
        opacity: 0;
        transform: scale(0.96) translateY(8px);
      }
    }
    dialog::backdrop {
      background: rgba(15, 23, 42, 0);
      backdrop-filter: blur(0px);
      transition:
        background 220ms ease,
        backdrop-filter 220ms ease,
        overlay 220ms ease allow-discrete,
        display 220ms ease allow-discrete;
    }
    dialog[open]::backdrop {
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(4px);
    }
    @starting-style {
      dialog[open]::backdrop {
        background: rgba(15, 23, 42, 0);
        backdrop-filter: blur(0px);
      }
    }
  </style>
</head>
<body class="min-h-screen text-slate-800 antialiased flex flex-col selection:bg-slate-900 selection:text-white overflow-x-hidden" style="background:#FAFAF9;">

<% if (!locals.hideChrome) { %>
  <header class="sticky top-3 sm:top-4 z-30 mx-3 sm:mx-4">
    <div class="max-w-6xl mx-auto">

      <% if (currentUser) { %>
        <%
          const userInitials = currentUser.name.trim().split(/\s+/).map(w => w[0]).slice(0,2).join('').toUpperCase();
          const companyInitial = currentCompany ? (currentCompany.name || '?').trim()[0].toUpperCase() : '';
        %>
        <nav class="okud-nav">
          <!-- Marka -->
          <a href="/dashboard" class="okud-brand">
            <span class="logo">F</span>
            <span class="name">Filoskope</span>
          </a>

          <!-- Orta linkler -->
          <div class="okud-links">
            <% if (currentCompany) { %>
              <a href="/dashboard"          class="okud-link" data-match="/dashboard">Dashboard</a>
              <a href="/company/fleet/drivers" class="okud-link" data-match="/company/fleet">Filo</a>
              <a href="/company/contracts"  class="okud-link" data-match="/company/contracts">Sözleşmeler</a>
              <a href="/notifications"      class="okud-link" data-match="/notifications">Bildirimler</a>
            <% } else { %>
              <a href="/dashboard"          class="okud-link" data-match="/dashboard">Dashboard</a>
              <a href="/profile"            class="okud-link" data-match="/profile">Profilim</a>
              <a href="/vehicles"           class="okud-link" data-match="/vehicles">Araçlarım</a>
              <a href="/notifications"      class="okud-link" data-match="/notifications">Bildirimler</a>
            <% } %>
          </div>

          <!-- Kurum pill (aktif kurum varsa) -->
          <% if (currentCompany) { %>
            <a href="/dashboard" class="okud-company-pill" title="Kurumu değiştir">
              <span class="av"><%= companyInitial %></span>
              <span class="nm"><%= currentCompany.name %></span>
              <i class="ti ti-selector ic"></i>
            </a>
          <% } %>

          <!-- Sağ aksiyonlar -->
          <div class="okud-actions">
            <!-- Bildirim + popover -->
            <div class="okud-bell-wrap">
              <button type="button" id="bell-btn" class="okud-icon-btn" aria-haspopup="menu" aria-expanded="false" aria-label="Bildirimler">
                <i class="ti ti-bell ic"></i>
                <% if (notificationUnreadCount > 0) { %>
                  <span class="badge" id="bell-badge"><%= notificationUnreadCount > 9 ? '9+' : notificationUnreadCount %></span>
                <% } %>
              </button>
              <div id="bell-popover" class="okud-bell-popover" role="menu">
                <div class="okud-bell-head">
                  <span class="t">Bildirimler</span>
                  <span class="cnt <%= notificationUnreadCount > 0 ? '' : 'zero' %>" id="bell-head-count">
                    <%= notificationUnreadCount > 99 ? '99+' : notificationUnreadCount %> yeni
                  </span>
                </div>
                <div class="okud-bell-list" id="bell-list">
                  <div class="okud-bell-loading">Yükleniyor…</div>
                </div>
                <a href="/notifications" class="okud-bell-foot">
                  Tümünü gör
                  <i class="ti ti-arrow-right ic"></i>
                </a>
              </div>
            </div>

            <!-- Avatar + dropdown -->
            <div class="okud-avatar-wrap">
              <button type="button" id="user-menu-btn" class="okud-avatar" aria-haspopup="menu" aria-expanded="false" aria-label="Kullanıcı menüsü">
                <%= userInitials %>
              </button>
              <div id="user-menu" class="okud-dropdown" role="menu">
                <div class="okud-dd-head">
                  <div class="n"><%= currentUser.name %></div>
                  <div class="m"><%= currentUser.email || '' %></div>
                </div>
                <a href="/profile" class="okud-dd-item"><i class="ti ti-user ic"></i>Profilim</a>
                <a href="/driver/profile" class="okud-dd-item"><i class="ti ti-steering-wheel ic"></i>Şoför Profilim</a>
                <a href="/vehicles" class="okud-dd-item"><i class="ti ti-car ic"></i>Araçlarım</a>
                <a href="/hostess" class="okud-dd-item"><i class="ti ti-users ic"></i>Hosteslerim</a>
                <% if (currentUser.isSuperadmin) { %>
                  <div class="okud-dd-sep"></div>
                  <a href="/admin" class="okud-dd-item is-admin"><i class="ti ti-shield ic"></i>Admin Paneli</a>
                <% } %>
                <div class="okud-dd-sep"></div>
                <form action="/logout" method="POST" style="margin:0;">
                  <button type="submit" class="okud-dd-item is-danger"><i class="ti ti-logout ic"></i>Çıkış</button>
                </form>
              </div>
            </div>
          </div>

          <!-- Mobil hamburger -->
          <button type="button" id="mobile-menu-btn" class="okud-burger" aria-label="Menü">
            <i class="ti ti-menu-2 ic"></i>
            <% if (notificationUnreadCount > 0) { %><span class="badge"></span><% } %>
          </button>
        </nav>

        <!-- MOBIL menü -->
        <div id="mobile-menu" class="okud-mobile-menu hidden">
          <div class="okud-mobile-head">
            <div class="av"><%= userInitials %></div>
            <div style="min-width:0; flex:1;">
              <div class="n"><%= currentUser.name %></div>
              <% if (currentCompany) { %>
                <div class="m"><%= currentCompany.name %></div>
              <% } %>
            </div>
          </div>
          <div class="okud-mobile-links">
            <a href="/dashboard"><i class="ti ti-home ic"></i>Dashboard</a>
            <a href="/profile"><i class="ti ti-user ic"></i>Profilim</a>
            <% if (currentCompany) { %>
              <a href="/company/fleet/drivers"><i class="ti ti-users ic"></i>Filo Paneli</a>
              <a href="/company/contracts"><i class="ti ti-file-text ic"></i>Sözleşmeler</a>
            <% } %>
            <a href="/driver/profile"><i class="ti ti-steering-wheel ic"></i>Şoför Profilim</a>
            <a href="/vehicles"><i class="ti ti-car ic"></i>Araçlarım</a>
            <a href="/hostess"><i class="ti ti-user-heart ic"></i>Hosteslerim</a>
            <a href="/notifications">
              <i class="ti ti-bell ic"></i>Bildirimler
              <% if (notificationUnreadCount > 0) { %>
                <span class="badge"><%= notificationUnreadCount > 99 ? '99+' : notificationUnreadCount %></span>
              <% } %>
            </a>
            <% if (currentUser.isSuperadmin) { %>
              <a href="/admin" class="admin"><i class="ti ti-shield ic"></i>Admin Paneli</a>
            <% } %>
            <form action="/logout" method="POST" style="margin:0;">
              <button type="submit" class="logout"><i class="ti ti-logout ic"></i>Çıkış</button>
            </form>
          </div>
        </div>

      <% } else { %>
        <!-- Auth öncesi (login/register) -->
        <nav class="okud-nav">
          <a href="/" class="okud-brand">
            <span class="logo">F</span>
            <span class="name">Filoskope</span>
          </a>
          <div class="okud-actions">
            <a href="/register" class="okud-link">Kayıt Ol</a>
            <a href="/login" style="background:#0F2A4A; color:white; padding:8px 18px; border-radius:9px; font-size:13.5px; font-weight:600; text-decoration:none;">Giriş</a>
          </div>
        </nav>
      <% } %>

    </div>
  </header>

  <% if (currentUser && !currentUser.emailVerifiedAt) { %>
    <div class="okud-verify-wrap mx-3 sm:mx-4">
      <div class="max-w-6xl mx-auto">
        <div class="okud-verify-banner">
          <span class="ic"><i class="ti ti-mail-exclamation" aria-hidden="true"></i></span>
          <div class="msg">
            <b><%= currentUser.email %></b> adresini henüz doğrulamadın. Doğrulanmış hesap tüm özelliklere erişir.
          </div>
          <form action="/verify-email/resend" method="POST">
            <button type="submit"><i class="ti ti-send"></i>Doğrulama linki gönder</button>
          </form>
        </div>
      </div>
    </div>
  <% } %>
<% } %>

  <main class="<%= locals.hideChrome ? 'w-full flex-1 animate-fade-up' : 'max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10 flex-1 animate-fade-up' %>">
    <%- body %>
  </main>

<% if (!locals.hideChrome) { %>
  <footer class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-8 mt-4 sm:mt-8">
    <div class="flex items-center justify-center gap-3 text-xs" style="color:#94A3B8;">
      <span style="position:relative; display:inline-flex; width:18px; height:18px; background:#0F2A4A; border-radius:5px; color:white; align-items:center; justify-content:center; font-weight:800; font-size:10px;">
        F
        <span style="position:absolute; bottom:-2px; right:-2px; width:6px; height:6px; background:#F59E0B; border-radius:50%; box-shadow:0 0 0 1.5px #FAFAF9;"></span>
      </span>
      <span style="font-weight:600; color:#0F2A4A;">Filoskope</span>
      <span style="color:#CBD5E1;">·</span>
      <span>Kurumsal Ulaşım ve Belge Denetim</span>
      <span style="color:#CBD5E1;">·</span>
      <span>v0.1</span>
    </div>
  </footer>
<% } %>

  <script>
    // ─────────────────────────────────────────
    // SweetAlert2 helpers — data-confirm pattern
    // ─────────────────────────────────────────
    (function () {
      document.addEventListener('submit', function (e) {
        const form = e.target;
        if (!form.dataset || !form.dataset.confirm) return;
        if (form.dataset._confirmed === '1') return;
        e.preventDefault();

        const isDanger = form.dataset.confirmDanger !== undefined;
        Swal.fire({
          title: form.dataset.confirmTitle || 'Emin misin?',
          text: form.dataset.confirm,
          icon: isDanger ? 'warning' : 'question',
          showCancelButton: true,
          confirmButtonText: form.dataset.confirmButton || (isDanger ? 'Evet, onaylıyorum' : 'Evet'),
          cancelButtonText: 'Vazgeç',
          reverseButtons: true,
          customClass: { confirmButton: isDanger ? '' : 'confirm-blue' },
          buttonsStyling: true,
        }).then(function (result) {
          if (result.isConfirmed) {
            form.dataset._confirmed = '1';
            form.submit();
          }
        });
      });

      window.toast = function (message, icon) {
        Swal.fire({
          toast: true, position: 'top-end',
          icon: icon || 'success', title: message,
          showConfirmButton: false, timer: 2500, timerProgressBar: true,
        });
      };

      // MOBIL MENÜ toggle
      const menuBtn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (menuBtn && menu) {
        menuBtn.addEventListener('click', function () {
          menu.classList.toggle('hidden');
        });
        menu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () { menu.classList.add('hidden'); });
        });
      }

      // AKTİF LİNK — data-match ile pathname eşleşen linke .active
      const path = window.location.pathname;
      document.querySelectorAll('.okud-link[data-match]').forEach(function (a) {
        const m = a.getAttribute('data-match');
        if (path === m || path.startsWith(m + '/')) a.classList.add('active');
      });

      // AVATAR DROPDOWN
      const avBtn = document.getElementById('user-menu-btn');
      const avMenu = document.getElementById('user-menu');
      if (avBtn && avMenu) {
        avBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          const isOpen = avMenu.classList.toggle('open');
          avBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          if (isOpen) closeBell();
        });
        document.addEventListener('click', function (e) {
          if (!avMenu.contains(e.target) && e.target !== avBtn) {
            avMenu.classList.remove('open');
            avBtn.setAttribute('aria-expanded', 'false');
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            avMenu.classList.remove('open');
            avBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Doğrulama maili gönderildi bildirimi (banner tarafından tetiklenir)
      if (window.location.search.indexOf('verifysent=1') !== -1) {
        window.toast && window.toast('Doğrulama linki e-postana gönderildi', 'success');
        // URL'i temizle — sayfa yenilenirse tekrar göstermesin
        if (window.history && window.history.replaceState) {
          const clean = window.location.pathname +
            window.location.search.replace(/[?&]verifysent=1/, '').replace(/^&/, '?');
          window.history.replaceState({}, document.title, clean);
        }
      }

      // ŞİFRE GÖSTER/GİZLE — tüm sayfalardaki input[type=password]'e göz butonu ekle
      (function enhancePasswordInputs() {
        const inputs = document.querySelectorAll('input[type="password"]');
        inputs.forEach(function (inp) {
          if (inp.dataset.pwEnhanced) return;
          inp.dataset.pwEnhanced = '1';

          const wrap = document.createElement('div');
          wrap.className = 'pw-wrap';
          inp.parentNode.insertBefore(wrap, inp);
          wrap.appendChild(inp);

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'pw-toggle';
          btn.setAttribute('aria-label', 'Şifreyi göster');
          btn.setAttribute('tabindex', '-1');
          btn.innerHTML = '<i class="ti ti-eye" aria-hidden="true"></i>';
          wrap.appendChild(btn);

          btn.addEventListener('click', function () {
            const isPw = inp.type === 'password';
            inp.type = isPw ? 'text' : 'password';
            const icon = btn.querySelector('i');
            icon.className = isPw ? 'ti ti-eye-off' : 'ti ti-eye';
            btn.setAttribute('aria-label', isPw ? 'Şifreyi gizle' : 'Şifreyi göster');
          });
        });
      })();

      // BELL POPOVER
      const bellBtn = document.getElementById('bell-btn');
      const bellPop = document.getElementById('bell-popover');
      const bellList = document.getElementById('bell-list');
      const bellHeadCount = document.getElementById('bell-head-count');
      let bellLoaded = false;

      function closeBell() {
        if (!bellPop) return;
        bellPop.classList.remove('open');
        if (bellBtn) bellBtn.setAttribute('aria-expanded', 'false');
      }
      function closeAvatar() {
        if (!avMenu) return;
        avMenu.classList.remove('open');
        if (avBtn) avBtn.setAttribute('aria-expanded', 'false');
      }

      function relTime(iso) {
        if (!iso) return '';
        const d = new Date(iso);
        const now = new Date();
        const diffSec = Math.round((now - d) / 1000);
        if (diffSec < 60)   return 'az önce';
        const diffMin = Math.round(diffSec / 60);
        if (diffMin < 60)   return diffMin + ' dakika önce';
        const diffH = Math.round(diffMin / 60);
        if (diffH < 24)     return diffH + ' saat önce';
        const diffD = Math.round(diffH / 24);
        if (diffD === 1)    return 'dün';
        if (diffD < 7)      return diffD + ' gün önce';
        return d.toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric' });
      }
      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      function renderBell(data) {
        const items = (data && data.items) || [];
        const unread = data ? data.unreadCount : 0;

        // Badge güncelle
        if (bellHeadCount) {
          bellHeadCount.textContent = (unread > 99 ? '99+' : unread) + ' yeni';
          bellHeadCount.classList.toggle('zero', unread === 0);
        }
        const oldBadge = document.getElementById('bell-badge');
        if (unread > 0) {
          if (oldBadge) {
            oldBadge.textContent = unread > 9 ? '9+' : unread;
          } else if (bellBtn) {
            const b = document.createElement('span');
            b.id = 'bell-badge'; b.className = 'badge';
            b.textContent = unread > 9 ? '9+' : unread;
            bellBtn.appendChild(b);
          }
        } else if (oldBadge) {
          oldBadge.remove();
        }

        if (items.length === 0) {
          bellList.innerHTML = '<div class="okud-bell-empty"><i class="ti ti-bell-off"></i>Şu an bildirimin yok.</div>';
          return;
        }
        bellList.innerHTML = items.map(function (n) {
          const isUnread = !n.read_at;
          return (
            '<a href="/notifications" class="okud-bell-item ' + (isUnread ? 'unread' : '') + '">' +
              '<span class="dot"></span>' +
              '<div class="info">' +
                '<div class="tt">' + esc(n.title) + '</div>' +
                '<div class="mt">' +
                  '<span>' + esc(relTime(n.created_at)) + '</span>' +
                  (n.company_name ? '<span>·</span><span class="comp">' + esc(n.company_name) + '</span>' : '') +
                '</div>' +
              '</div>' +
            '</a>'
          );
        }).join('');
      }

      async function loadBell() {
        try {
          const r = await fetch('/notifications/recent.json', { credentials: 'same-origin' });
          if (!r.ok) throw new Error('http ' + r.status);
          const data = await r.json();
          renderBell(data);
          bellLoaded = true;
        } catch (err) {
          bellList.innerHTML = '<div class="okud-bell-empty">Bildirimler yüklenemedi.</div>';
        }
      }

      if (bellBtn && bellPop) {
        bellBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          const isOpen = bellPop.classList.toggle('open');
          bellBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          if (isOpen) {
            closeAvatar();
            if (!bellLoaded) loadBell();
          }
        });
        document.addEventListener('click', function (e) {
          if (!bellPop.contains(e.target) && e.target !== bellBtn && !bellBtn.contains(e.target)) {
            closeBell();
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeBell();
        });
      }
    })();
  </script>

  <!-- CSRF: her POST formuna gizli _csrf alanını otomatik ekle.
       Böylece 80+ formu tek tek düzenlemeye gerek kalmaz; SweetAlert'in
       form.submit() ile gönderdiği formlar da kapsanır (alan zaten DOM'da). -->
  <script>
    (function () {
      var meta = document.querySelector('meta[name="csrf-token"]');
      var token = meta ? meta.getAttribute('content') : '';
      if (!token) return;
      document.querySelectorAll('form').forEach(function (form) {
        var m = (form.getAttribute('method') || '').toLowerCase();
        if (m !== 'post') return;
        if (form.querySelector('input[name="_csrf"]')) return;
        var i = document.createElement('input');
        i.type = 'hidden'; i.name = '_csrf'; i.value = token;
        form.appendChild(i);
      });
    })();
  </script>

</body>
</html>
