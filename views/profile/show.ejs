<%
  const initials = (currentUser.name || '?').trim().split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();
  const flashMap = {
    'name-ok':  'Ad ve soyad güncellendi.',
    'email-ok': 'E-posta adresi güncellendi.',
    'pw-ok':    'Şifre güncellendi.',
  };
  const flashMessage = flash ? flashMap[flash] : null;

  function fmtJoinDate(d) {
    if (!d) return '';
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return '';
    return dt.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
  }
%>

<div class="user-view">
  <div class="prof-view">

    <!-- HERO -->
    <div class="prof-hero">
      <div class="avatar"><%= initials %></div>
      <div class="who">
        <div class="n"><%= user.first_name %> <%= user.last_name %></div>
        <div class="em"><%= user.email %></div>
        <div class="meta">
          <span><i class="ti ti-calendar" style="font-size:13px; vertical-align:-2px; margin-right:3px;"></i>Katılım: <%= fmtJoinDate(user.created_at) %></span>
          <% if (user.is_superadmin) { %>
            <span class="badge-sa"><i class="ti ti-shield" style="font-size:11px;"></i>SuperAdmin</span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- STATS -->
    <div class="prof-stats">
      <div class="prof-stat">
        <div class="lab">Bağlı kurum</div>
        <div class="val"><%= stats.companyCount %></div>
      </div>
      <div class="prof-stat">
        <div class="lab">Okunmamış bildirim</div>
        <div class="val"><%= stats.unreadCount %></div>
      </div>
      <div class="prof-stat">
        <div class="lab">Hesap yaşı</div>
        <div class="val"><%= stats.accountAgeDays %><small>gün</small></div>
      </div>
    </div>

    <!-- FLASH -->
    <% if (flashMessage) { %>
      <div class="prof-flash">
        <i class="ti ti-circle-check"></i>
        <%= flashMessage %>
      </div>
    <% } %>

    <!-- FORM: Ad + Soyad -->
    <section class="prof-card">
      <div class="prof-card-head">
        <div class="row">
          <span class="ic b-nav"><i class="ti ti-user"></i></span>
          <h2>Ad ve soyad</h2>
        </div>
        <div class="desc">İsim değişikliğin anında yansır — kurumlar ve filo panelleri güncellenir.</div>
      </div>

      <% if (errorSection === 'name') { %>
        <div class="prof-error">
          <i class="ti ti-alert-triangle"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/profile/name" method="POST" class="prof-grid">
        <div class="prof-field">
          <label>Ad</label>
          <input type="text" name="first_name" required maxlength="100"
                 value="<%= (errorSection === 'name' ? (formData.first_name || '') : user.first_name) %>">
        </div>
        <div class="prof-field">
          <label>Soyad</label>
          <input type="text" name="last_name" required maxlength="100"
                 value="<%= (errorSection === 'name' ? (formData.last_name || '') : user.last_name) %>">
        </div>
        <div class="full prof-actions">
          <button type="submit" class="prof-submit">
            Kaydet <i class="ti ti-check"></i>
          </button>
        </div>
      </form>
    </section>

    <!-- FORM: E-posta -->
    <section class="prof-card">
      <div class="prof-card-head">
        <div class="row">
          <span class="ic b-good"><i class="ti ti-mail"></i></span>
          <h2>E-posta adresi</h2>
        </div>
        <div class="desc">Şu an: <b><%= user.email %></b> · değişiklik için mevcut şifreni doğrulaman gerekir.</div>
      </div>

      <% if (errorSection === 'email') { %>
        <div class="prof-error">
          <i class="ti ti-alert-triangle"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/profile/email" method="POST" class="prof-grid">
        <div class="full prof-field">
          <label>Yeni e-posta</label>
          <input type="email" name="new_email" required autocomplete="email"
                 value="<%= errorSection === 'email' ? (formData.new_email || '') : '' %>">
        </div>
        <div class="full prof-field">
          <label>Mevcut şifre</label>
          <input type="password" name="current_password" required autocomplete="current-password">
        </div>
        <div class="full prof-actions">
          <button type="submit" class="prof-submit">
            E-postayı güncelle <i class="ti ti-arrow-right"></i>
          </button>
        </div>
      </form>
    </section>

    <!-- FORM: Şifre -->
    <section class="prof-card">
      <div class="prof-card-head">
        <div class="row">
          <span class="ic b-accent"><i class="ti ti-lock"></i></span>
          <h2>Şifre</h2>
        </div>
        <div class="desc">En az 8 karakter · mevcut şifren ile onaylanır.</div>
      </div>

      <% if (errorSection === 'password') { %>
        <div class="prof-error">
          <i class="ti ti-alert-triangle"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/profile/password" method="POST" class="prof-grid">
        <div class="full prof-field">
          <label>Mevcut şifre</label>
          <input type="password" name="current_password" required autocomplete="current-password">
        </div>
        <div class="prof-field">
          <label>Yeni şifre</label>
          <input type="password" name="new_password" required minlength="8" autocomplete="new-password">
        </div>
        <div class="prof-field">
          <label>Yeni şifre (tekrar)</label>
          <input type="password" name="new_password_confirm" required minlength="8" autocomplete="new-password">
        </div>
        <div class="full prof-actions">
          <button type="submit" class="prof-submit">
            Şifreyi güncelle <i class="ti ti-check"></i>
          </button>
        </div>
      </form>
    </section>

  </div>
</div>
