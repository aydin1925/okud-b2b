<div class="auth-shell">

  <div class="auth-topbar">
    <a href="/" class="auth-logo">
      <span class="box">O</span>
      <span class="name">OKUD</span>
    </a>
  </div>

  <div class="auth-preview">

    <!-- Sol: form -->
    <div class="form-side">
      <div class="auth-form-card">
      <div class="auth-eyebrow">Başlayalım</div>
      <h1 class="auth-title">Hesap oluştur</h1>
      <p class="auth-sub">30 saniye sürer. Sonrasında filonu tanımla, davet gönder, işini başlat.</p>

      <% if (error) { %>
        <div class="auth-alert err">
          <i class="ti ti-alert-circle"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="auth-alert ok">
          <i class="ti ti-mail-check"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <form action="/register" method="POST" class="auth-fields">
        <div class="auth-grid-2">
          <div class="auth-field">
            <label for="first_name">Ad</label>
            <div class="input-wrap">
              <i class="ti ti-user field-icon" aria-hidden="true"></i>
              <input type="text" id="first_name" name="first_name" value="<%= formData.first_name || '' %>" required maxlength="100" placeholder="Aydın">
            </div>
          </div>
          <div class="auth-field">
            <label for="last_name">Soyad</label>
            <div class="input-wrap">
              <i class="ti ti-user field-icon" aria-hidden="true"></i>
              <input type="text" id="last_name" name="last_name" value="<%= formData.last_name || '' %>" required maxlength="100" placeholder="Şahin">
            </div>
          </div>
        </div>

        <div class="auth-field">
          <label for="email">E-posta</label>
          <div class="input-wrap">
            <i class="ti ti-mail field-icon" aria-hidden="true"></i>
            <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required autocomplete="email" placeholder="ornek@mail.com">
          </div>
        </div>

        <div class="auth-field">
          <label for="password">Şifre</label>
          <div class="input-wrap">
            <i class="ti ti-lock field-icon" aria-hidden="true"></i>
            <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" placeholder="En az 8 karakter">
          </div>
          <div class="hint">Güçlü bir şifre seç · büyük harf, sayı, sembol karışsın.</div>
        </div>

        <button type="submit" class="auth-submit">
          Hesabı oluştur <i class="ti ti-arrow-right"></i>
        </button>
      </form>

      <p class="auth-swap">
        Zaten hesabın var mı? <a href="/login">Giriş yap</a>
      </p>
      </div>
    </div>

    <!-- Sağ: ürün önizlemesi -->
    <div class="preview-side">
      <div class="auth-preview-card">
        <div class="auth-preview-chrome">
          <span class="dot r"></span>
          <span class="dot y"></span>
          <span class="dot g"></span>
          <span class="url">okud.tr/dashboard</span>
        </div>
        <div class="auth-preview-body">
          <div class="auth-preview-hi">Bugün · 11 Eylül</div>
          <div class="auth-preview-name">Merhaba, Aydın 👋</div>

          <div class="auth-preview-stats">
            <div class="auth-preview-stat ok">
              <div class="l">Aktif</div>
              <div class="v">24</div>
            </div>
            <div class="auth-preview-stat wt">
              <div class="l">Yaklaşan</div>
              <div class="v">3</div>
            </div>
            <div class="auth-preview-stat rj">
              <div class="l">Süresi Doldu</div>
              <div class="v">1</div>
            </div>
          </div>

          <div class="auth-preview-row">
            <div class="av">MK</div>
            <div class="text"><b>Mehmet K.</b> · ehliyet 12 gün</div>
            <div class="tag wt">Süre</div>
          </div>
          <div class="auth-preview-row">
            <div class="plate">
              <div class="tr">TR</div>
              <div class="num">33 S 6062</div>
            </div>
            <div class="text"><b>Ford Transit</b> · sigorta</div>
            <div class="tag ok">OK</div>
          </div>
          <div class="auth-preview-row" style="margin-bottom:0;">
            <div class="av" style="background:var(--accent);">EY</div>
            <div class="text"><b>Elif Y.</b> · sağlık raporu</div>
            <div class="tag ok">Onaylı</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
