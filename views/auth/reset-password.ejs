<div class="auth-shell">

  <div class="auth-topbar">
    <a href="/" class="auth-logo">
      <span class="box">O</span>
      <span class="name">OKUD</span>
    </a>
  </div>

  <div class="auth-solo">
    <div class="card">
      <% if (expired) { %>
        <div class="auth-solo-done">
          <div class="auth-solo-done-icon err"><i class="ti ti-clock-off"></i></div>
          <h1>Bağlantı çalışmıyor</h1>
          <p><%= error || 'Bu bağlantı geçersiz veya süresi dolmuş olabilir.' %> Yeni bir sıfırlama linki iste.</p>
          <a href="/forgot-password" class="auth-submit" style="max-width:220px; margin:0 auto;">
            Yeni link iste <i class="ti ti-arrow-right"></i>
          </a>
        </div>
      <% } else { %>
        <div class="auth-eyebrow">Yeni şifre</div>
        <h1 class="auth-title">Şifreni sıfırla</h1>
        <p class="auth-sub">En az 8 karakter olacak şekilde yeni bir şifre belirle. Kaydettiğin anda giriş yapabilirsin.</p>

        <% if (error) { %>
          <div class="auth-alert err">
            <i class="ti ti-alert-circle"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/reset-password" method="POST" class="auth-fields">
          <input type="hidden" name="token" value="<%= token %>">

          <div class="auth-field">
            <label for="new_password">Yeni şifre</label>
            <div class="input-wrap">
              <i class="ti ti-lock field-icon" aria-hidden="true"></i>
              <input type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password" placeholder="En az 8 karakter">
            </div>
          </div>

          <div class="auth-field">
            <label for="new_password_confirm">Yeni şifre (tekrar)</label>
            <div class="input-wrap">
              <i class="ti ti-lock field-icon" aria-hidden="true"></i>
              <input type="password" id="new_password_confirm" name="new_password_confirm" required minlength="8" autocomplete="new-password" placeholder="Aynı şifreyi tekrarla">
            </div>
          </div>

          <button type="submit" class="auth-submit">
            Şifreyi güncelle <i class="ti ti-check"></i>
          </button>
        </form>

        <p class="auth-swap">
          <a href="/login">Girişe dön</a>
        </p>
      <% } %>
    </div>
  </div>
</div>
