<div class="auth-shell">

  <div class="auth-topbar">
    <a href="/" class="auth-logo">
      <span class="box">O</span>
      <span class="name">OKUD</span>
    </a>
  </div>

  <div class="auth-editorial">

    <!-- Sol: form -->
    <div class="form-side">
      <div class="auth-form-card">
        <div class="auth-eyebrow">Hoş geldin</div>
        <h1 class="auth-title">Hesabına giriş yap</h1>
        <p class="auth-sub">E-posta ve şifrenle devam et. Şifreni unuttuysan hemen yeni bir tane oluşturabilirsin.</p>

        <% if (typeof info !== 'undefined' && info) { %>
          <div class="auth-alert ok">
            <i class="ti ti-circle-check"></i>
            <span><%= info %></span>
          </div>
        <% } %>

        <% if (error) { %>
          <div class="auth-alert err">
            <i class="ti ti-alert-circle"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/login" method="POST" class="auth-fields">
          <div class="auth-field">
            <label for="email">E-posta</label>
            <div class="input-wrap">
              <i class="ti ti-mail field-icon" aria-hidden="true"></i>
              <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required autocomplete="email" placeholder="ornek@mail.com">
            </div>
          </div>

          <div class="auth-field">
            <div class="label-row">
              <label for="password">Şifre</label>
              <a href="/forgot-password">Şifremi unuttum</a>
            </div>
            <div class="input-wrap">
              <i class="ti ti-lock field-icon" aria-hidden="true"></i>
              <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
            </div>
          </div>

          <button type="submit" class="auth-submit">
            Giriş yap <i class="ti ti-arrow-right"></i>
          </button>
        </form>

        <p class="auth-swap">
          Hesabın yok mu? <a href="/register">Kayıt ol</a>
        </p>
      </div>
    </div>

    <!-- Sağ: editoryel panel -->
    <div class="brand-side">
      <span class="ghost" aria-hidden="true">OKUD</span>
      <div class="content">
        <div class="tag">Belge denetimi · Otonom</div>
        <h1>Süresi dolan<br>hiçbir belge<br><em>gözden kaçmasın.</em></h1>
        <p>Şoför, kurum ve araç belgelerini tek merkezden takip et. Ehliyeti dolan şoför yola çıkmasın, sen haberdar olmadan hiçbir sözleşme askıya alınmasın.</p>
      </div>
    </div>

  </div>
</div>
