<div class="auth-shell">

  <div class="auth-topbar">
    <a href="/" class="auth-logo">
      <span class="box">O</span>
      <span class="name">OKUD</span>
    </a>
    <div class="aside">
      <% if (currentUser) { %>
        <a href="/dashboard">Dashboard</a>
      <% } else { %>
        <a href="/login">Giriş yap</a>
      <% } %>
    </div>
  </div>

  <div class="auth-solo">
    <div class="card">
      <div class="auth-solo-done">
        <% if (success) { %>
          <div class="auth-solo-done-icon ok"><i class="ti ti-mail-check"></i></div>
          <h1>E-posta doğrulandı</h1>
          <p>Hesabın artık tam aktif. OKUD'un tüm özelliklerini kısıtsız kullanabilirsin.</p>
          <% if (currentUser) { %>
            <a href="/dashboard" class="auth-submit" style="max-width:220px; margin:0 auto;">
              Dashboard'a git <i class="ti ti-arrow-right"></i>
            </a>
          <% } else { %>
            <a href="/login?flash=email-verified" class="auth-submit" style="max-width:220px; margin:0 auto;">
              Giriş yap <i class="ti ti-arrow-right"></i>
            </a>
          <% } %>
        <% } else { %>
          <div class="auth-solo-done-icon err"><i class="ti ti-alert-circle"></i></div>
          <h1>Doğrulama başarısız</h1>
          <p><%= error || 'Bu bağlantı geçersiz veya süresi dolmuş olabilir.' %></p>
          <% if (currentUser) { %>
            <form action="/verify-email/resend" method="POST" style="margin:0;">
              <button type="submit" class="auth-submit" style="max-width:220px; margin:0 auto;">
                Yeni link gönder <i class="ti ti-send"></i>
              </button>
            </form>
          <% } else { %>
            <a href="/login" class="auth-submit" style="max-width:220px; margin:0 auto;">
              Giriş yap
            </a>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</div>
