<div class="auth-shell">

  <div class="auth-topbar">
    <a href="/" class="auth-logo">
      <span class="box">F</span>
      <span class="name">Filoskope</span>
    </a>
  </div>

  <div class="auth-solo">
    <div class="card">
      <% if (sent) { %>
        <div class="auth-solo-done">
          <div class="auth-solo-done-icon ok"><i class="ti ti-mail-fast"></i></div>
          <h1>Postanı kontrol et</h1>
          <p>
            Eğer <strong style="color:var(--ink);"><%= email %></strong> adresi sistemde kayıtlıysa,
            içinde sıfırlama linki olan bir mail birazdan sana ulaşacak. Link <strong>60 dakika</strong> geçerli.
          </p>
          <a href="/login" class="auth-submit" style="max-width:220px; margin:0 auto;">
            Giriş sayfasına dön <i class="ti ti-arrow-right"></i>
          </a>
          <p class="auth-swap" style="margin-top:22px;">
            Farklı bir adres denemek ister misin? <a href="/forgot-password">Tekrar dene</a>
          </p>
        </div>
      <% } else { %>
        <div class="auth-eyebrow">Şifre sıfırlama</div>
        <h1 class="auth-title">Şifreni mi unuttun?</h1>
        <p class="auth-sub">E-posta adresini gir, sana kısa süreli bir sıfırlama linki gönderelim.</p>

        <% if (error) { %>
          <div class="auth-alert err">
            <i class="ti ti-alert-circle"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/forgot-password" method="POST" class="auth-fields">
          <div class="auth-field">
            <label for="email">E-posta</label>
            <div class="input-wrap">
              <i class="ti ti-mail field-icon" aria-hidden="true"></i>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="ornek@mail.com">
            </div>
          </div>

          <button type="submit" class="auth-submit">
            Sıfırlama linki gönder <i class="ti ti-send"></i>
          </button>
        </form>

        <p class="auth-swap">
          Şifreni hatırladın mı? <a href="/login">Giriş yap</a>
        </p>
      <% } %>
    </div>
  </div>
</div>
