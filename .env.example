# Ortam — canlıda MUTLAKA "production" olmalı.
# (secure cookie, sıkı rate limit, CORS kapalı, hata detayı gizli bunlara bağlı.)
NODE_ENV=production

# Database (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=filoskope_db

# Session
SESSION_SECRET=change-me-with-a-long-random-string

JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=3000
APP_URL=http://localhost:3000

# Mail (SMTP — Brevo, Mailtrap, Gmail vs.)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=xxxxxxxxx@smtp-brevo.com
MAIL_PASS=change-me-with-brevo-smtp-key
MAIL_FROM="Filoskope <noreply@filoskope.com>"
# CSRF (double-submit HMAC anahtarı) - üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
# API CORS allowlist (virgülle ayır; boşsa prod kapalı, dev serbest)
CORS_ORIGINS=
